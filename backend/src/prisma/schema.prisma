// ============================================================================
// AvukatPro Veritabanı Şeması (Prisma)
// Açıklama: AvukatPro uygulamasının veritabanı yapısı
// Bu şema PostgreSQL için tasarlanmıştır
// 
// Şema Yapısı:
// - users: Avukat kullanıcılar
// - subscriptions: Abonelik bilgileri
// - cases: Dosya/dava bilgileri
// - hearings: Duruşmalar
// - notifications: Tebligatlar
// - delegations: Tevkiller
// - documents: Belgeler
// - document_embeddings: RAG için vektör embeddings
// - reminders: Hatırlatıcılar
// - ai_config: AI yapılandırma
// - user_tokens: Token kullanım takibi
// - uets_sessions: UETS oturum bilgileri
// - audit_logs: Denetim kayıtları
// - complaints: Tevkil şikayetleri
// ============================================================================

generator client {
  // Prisma Client oluşturucu ayarları
  // Çıktı klasörü: src/database/generated-client
  provider = "prisma-client-js"
}

datasource db {
  // Veritabanı bağlantı ayarları
  // DATABASE_URL environment değişkeninden okunur
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// KULLANICI (USERS) TABLOSU
// Açıklama: Avukat kullanıcılarının temel bilgilerini saklar
// Diğer tablolarla ilişkiler:
// - subscriptions (1:N) - Her kullanıcının bir aboneliği olabilir
// - cases (1:N) - Her kullanıcının birden fazla dosyası olabilir
// - delegations (1:N, from) - Gönderilen tevkiller
// - delegations (1:N, to) - Alınan tevkiller
// - notifications (1:N) - Kullanıcının tebligatları
// - documents (1:N) - Kullanıcının belgeleri
// - reminders (1:N) - Kullanıcının hatırlatıcılar
// ============================================================================
model User {
  id            String    @id @default(uuid()) // Benzersiz kullanıcı ID (UUID formatında)
  email         String    @unique // E-posta adresi - benzersiz olmalı
  passwordHash  String    @map("password_hash") // Şifrelenmiş şifre (bcrypt ile)
  name          String // Ad soyad
  phone         String?   @unique // Telefon numarası (opsiyonel, benzersiz)
  phoneVerified Boolean   @default(false) @map("phone_verified") // Telefon doğrulandı mı?
  avatarUrl     String?   @map("avatar_url") // Profil fotoğrafı URL'i

  // Mesleki bilgiler
  baroReg       String?   @map("baro_reg") // Baro kayıt numarası
  expertise     String[]  @default([]) // Uzmanlık alanları (dizi olarak saklanır)
  city          String? // Çalışma şehri
  district      String? // Çalışma ilçesi
  court         String? // Çalışma adliyesi

  // Rol sistemi - Büro yönetimi için
  role          UserRole  @default(LAWYER) // lawyer, office_admin, super_admin
  officeId      String?   @map("office_id") // Büro ID (ekip yönetimi için)

  // Puanlama sistemi
  rating        Decimal   @default(0) @db.Decimal(3,2) // Ortalama puan (0-5 arası)
  ratingCount   Int       @default(0) @map("rating_count") // Toplam puan sayısı

  // Abonelik durumu
  subscriptionStatus String   @default("free") @map("subscription_status")

  // Doğrulama durumu (Admin onayı)
  isVerified     Boolean   @default(false) @map("is_verified") // Admin tarafından onaylandı mı

  // KVKK ve açık rıza
  kvkkConsent   Boolean   @default(false) @map("kvkk_consent") // KVKK metni kabul edildi mi
  kvkkConsentAt DateTime? @map("kvkk_consent_at") // KVKK kabul tarihi
  claudeConsent Boolean   @default(false) @map("claude_consent") // Claude kullanımı için açık rıza
  claudeConsentAt DateTime? @map("claude_consent_at") // Claude rıza tarihi

  // Push bildirim token'ları
  pushToken     String?   @map("push_token") // FCM push token
  whatsappNotif Boolean   @default(false) @map("whatsapp_notif") // WhatsApp bildirim aktif mi

  // Telegram
  telegramId    String?   @map("telegram_id") // Telegram kullanıcı ID'si

  // Bildirim tercihleri (JSON)
  notificationPreferences Json?   @map("notification_preferences") // { push: true, email: true, sms: false, whatsapp: true }

  // Zaman bilgileri
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at") // Soft delete için

  // --------------------------------------------------------------------
  // İLİŞKİLER
  // --------------------------------------------------------------------
  // Abonelik - Bire çok ilişki (1 User : N Subscription)
  subscriptions  Subscription[]
  // Dosyalar - Bire çok ilişki (1 User : N Case)
  cases          Case[]
  // Bildirimler - Bire çok ilişki (1 User : N Notification)
  notifications  Notification[]
  // Belgeler - Bire çok ilişki (1 User : N Document)
  documents      Document[]
  // Hatırlatıcılar - Bire çok ilişki (1 User : N Reminder)
  reminders      Reminder[]
  // Gönderilen tevkiller - Bire çok ilişki (1 User : N Delegation)
  sentDelegations Delegation[] @relation("SentDelegations")
  // Alınan tevkiller - Bire çok ilişki (1 User : N Delegation)
  receivedDelegations Delegation[] @relation("ReceivedDelegations")
  // Token kullanımı - Bire çok ilişki (1 User : N UserToken)
  tokenUsage     UserToken[]
  // UETS oturumları - Bire çok ilişki (1 User : N UetsSession)
  uetsSessions   UetsSession[]
  // AI yapılandırma güncellemeleri - Bire çok ilişki (1 User : N AiConfig)
  aiConfigUpdates AiConfigUpdate[]
  // Denetim kayıtları - Bire çok ilişki (1 User : N AuditLog)
  auditLogs      AuditLog[]
  // Şikayetler - Bire çok ilişki (1 User : N Complaint)
  complaintsFiled Complaint[] @relation("ComplaintsFiled")
  complaintsAgainst Complaint[] @relation("ComplaintsAgainst")

  @@index([email]) // E-posta ile hızlı arama
  @@index([phone]) // Telefon ile hızlı arama
  @@index([city]) // Şehir ile arama (tevkil eşleştirme için)
  @@index([role]) // Rol ile arama
  @@map("users")
}

// Kullanıcı rolü enum'u
enum UserRole {
  LAWYER      // Sıradan avukat
  OFFICE_ADMIN // Büro yöneticisi (ekip yönetebilir)
  SUPER_ADMIN  // Sistem yöneticisi (tam yetki)
}

// ============================================================================
// ABONELİK (SUBSCRIPTIONS) TABLOSU
// Açıklama: Kullanıcıların abonelik bilgilerini saklar
// Her kullanıcının bir aktif aboneliği olabilir
// Diğer tablolarla ilişkiler:
// - user (N:1) - Aboneliğin sahibi
// ============================================================================
model Subscription {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  packageType   SubscriptionPackage @default(BASIC) // basic, standard, professional, enterprise
  tokenLimit    Int       @map("token_limit") // Aylık token limiti
  tokensUsed    Int       @default(0) @map("tokens_used") // Kullanılan token sayısı
  startDate     DateTime  @map("start_date")
  endDate       DateTime  @map("end_date")
  isActive      Boolean   @default(true) @map("is_active")
  autoRenew     Boolean   @default(true) @map("auto_renew")
  createdAt     DateTime  @default(now()) @map("created_at")

  // --------------------------------------------------------------------
  // İLİŞKİLER
  // --------------------------------------------------------------------
  // Kullanıcı - Çoktan bire ilişki (N User : 1 Subscription)
  user          User      @relation(fields: [userId], references: [id])

  @@index([userId]) // Kullanıcı ID ile arama
  @@index([isActive]) // Aktif aboneleri bulma
  @@map("subscriptions")
}

// Abonelik paketi enum'u
enum SubscriptionPackage {
  FREE        // Ücretsiz paket (temel özellikler)
  BASIC       // 199₺/ay - Tebligat, Tevkil, Hatırlatıcı
  STANDARD    // 499₺/ay - Basic + UYAP, Dosya analizi, Aleyhe/Lehe
  PROFESSIONAL // 999₺/ay - Standard + Dilekçe, İhtarname, Revize, 10.000 token/ay
  ENTERPRISE  // 1999₺/ay - Professional + İçtihat, Sınırsız RAG, 50.000 token/ay
}

// ============================================================================
// DOSYA/CASE (CASES) TABLOSU
// Açıklama: Avukatların takip ettiği dava dosyalarını saklar
// Diğer tablolarla ilişkiler:
// - user (N:1) - Dosyanın sahibi avukat
// - hearings (1:N) - Dosyaya ait duruşmalar
// - notifications (1:N) - Dosyaya ait tebligatlar
// - delegations (1:N) - Dosya ile ilgili tevkiller
// - documents (1:N) - Dosyaya ait belgeler
// - reminders (1:N) - Dosyaya ait hatırlatıcılar
// ============================================================================
model Case {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  caseNumber    String    @map("case_number") // Dosya numarası
  court         String? // Mahkeme adı
  parties       Json? // Taraflar bilgisi (JSON formatında saklanır)
  subject       String? // Dava konusu
  status        CaseStatus @default(ACTIVE) // active, closed, archived
  aiSummary     String?   @map("ai_summary") // AI tarafından oluşturulan özet
  decisionAnalysis Json? @map("decision_analysis") // Karar analizi sonuçları
  decisionSide  Json?     @map("decision_side") // Aleyhte/Lehte tespiti (aleyh: [], lehte: [])
  
  // Yapılacaklar ve kronoloji (AI tarafından önerilen)
  actionItems   Json?     @default("[]") @map("action_items") // AI önerili yapılacaklar [{task, deadline, priority, status}]
  timelineUpdates Json?   @default("[]") @map("timeline_updates") // Kronolojik gelişmeler [{date, type, description}]

  // UYAP bilgileri (Chrome eklentisi için)
  uyapId        String?   @map("uyap_id") // UYAP'taki dosya ID'si
  uyapUrl       String?   @map("uyap_url") // UYAP dosya URL'i

  // Tahkim/RAG için dosya durumu
  ragIndexed    Boolean   @default(false) @map("rag_indexed") // RAG sistemine eklenmiş mi
  lastRagSyncAt DateTime? @map("last_rag_sync_at") // Son RAG senkronizasyonu

  // Zaman bilgileri
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  // --------------------------------------------------------------------
  // İLİŞKİLER
  // --------------------------------------------------------------------
  // Kullanıcı - Çoktan bire ilişki (N Case : 1 User)
  user          User      @relation(fields: [userId], references: [id])
  // Duruşmalar - Bire çok ilişki (1 Case : N Hearing)
  hearings      Hearing[]
  // Bildirimler - Bire çok ilişki (1 Case : N Notification)
  notifications Notification[]
  // Tevkiller - Bire çok ilişki (1 Case : N Delegation)
  delegations  Delegation[]
  // Belgeler - Bire çok ilişki (1 Case : N Document)
  documents     Document[]
  // Hatırlatıcılar - Bire çok ilişki (1 Case : N Reminder)
  reminders     Reminder[]
  // Belge embedding'leri - Bire çok ilişki (1 Case : N DocumentEmbedding)
  embeddings    DocumentEmbedding[]

  @@unique([userId, caseNumber]) // Aynı kullanıcıda dosya numarası benzersiz olmalı
  @@index([userId]) // Kullanıcı ID ile arama
  @@index([status]) // Durum ile arama
  @@index([uyapId]) // UYAP ID ile arama (eklenti için)
  @@map("cases")
}

// Duruşma durumu enum'u
enum CaseStatus {
  ACTIVE   // Aktif dava
  CLOSED   // Kapatılmış dava
  ARCHIVED // Arşivlenmiş dava
}

// ============================================================================
// DURUŞMA (HEARINGS) TABLOSU
// Açıklama: Her davaya ait duruşma bilgilerini saklar
// Diğer tablolarla ilişkiler:
// - case (N:1) - Duruşmanın ait olduğu dava
// ============================================================================
model Hearing {
  id            String    @id @default(uuid())
  caseId        String    @map("case_id")
  hearingDate   DateTime  @map("hearing_date") // Duruşma tarihi ve saati
  court         String? // Mahkeme adı (dava mahkemesinden farklı olabilir)
  status        HearingStatus @default(SCHEDULED) // scheduled, held, postponed, cancelled
  notes         String? // Notlar
  result        String? // Duruşma sonucu
  createdAt     DateTime  @default(now()) @map("created_at")

  // --------------------------------------------------------------------
  // İLİŞKİLER
  // --------------------------------------------------------------------
  // Dava - Çoktan bire ilişki (N Hearing : 1 Case)
  case          Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId]) // Dava ID ile arama
  @@index([hearingDate]) // Tarih ile arama (yaklaşan duruşmaları bulmak için)
  @@map("hearings")
}

// Duruşma durumu enum'u
enum HearingStatus {
  SCHEDULED // Planlanmış
  HELD // Yapıldı
  POSTPONED // Ertelendi
  CANCELLED // İptal edildi
}

// ============================================================================
// TEBLİGAT (NOTIFICATIONS) TABLOSU
// Açıklama: UETS'ten gelen tebligatları ve sistem bildirimlerini saklar
// Diğer tablolarla ilişkiler:
// - user (N:1) - Tebligatın alıcısı
// - case (N:1) - İlgili dava (opsiyonel)
// 
// 5 GÜN KURALI:
// - uetsRead = false AND sentDate + 5 gün < now → Otomatik indir ve işle
// - uetsRead = true → Hemen indir, süre başladı
// ============================================================================
model Notification {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  caseId        String?   @map("case_id")
  type          NotificationType // Ara karar, duruşma, süreli bildirim, tevkil
  title         String // Başlık
  content       String? // İçerik özeti

  // Süre bilgisi - AI tarafından çıkarılır
  deadline      DateTime? // Süre bitiş tarihi (hesaplanmış)
  deadlineDays  Int? @map("deadline_days") // Kaç gün kaldı (kalan süre)
  deadlineStart DateTime? @map("deadline_start") // Süre başlangıç tarihi (okunma veya 5. gün)
  deadlineType  String?   @map("deadline_type") // itiraz, temyiz, cevap, vs.

  // Tebligat detayları
  sentDate      DateTime? @map("sent_date") // Gönderim tarihi (UETS'ten)
  readDate      DateTime? @map("read_date") // Okunma tarihi
  isRead        Boolean   @default(false) @map("is_read")
  isStarred     Boolean   @default(false) @map("is_starred")

  // UETS bilgileri - 5 gün kuralı için
  uetsId        String?   @map("uets_id") // UETS'teki tebligat ID'si
  uetsRead      Boolean   @default(false) @map("uets_read") // UETS'te okundu mu?
  uetsOpenedAt  DateTime? @map("uets_opened_at") // UETS'te açılma tarihi
  uetsProcessed Boolean   @default(false) @map("uets_processed") // İşlendi mi (AI özet, hatırlatıcı)
  uetsAutoProcessAt DateTime? @map("uets_auto_process_at") // Otomatik işleme tarihi (sentDate + 5 gün)

  // AI analiz sonuçları
  aiSummary     String?   @map("ai_summary") // AI özeti
  aiConfidence  Decimal?  @db.Decimal(3,2) @map("ai_confidence") // AI güven skoru
  aiModelUsed   String?   @map("ai_model_used") // Hangi AI ile analiz edildi

  // Dosya bilgisi
  fileUrl       String?   @map("file_url") // Tebligat dosyası URL'i (R2'de)
  fileName      String?   @map("file_name") // Dosya adı

  createdAt     DateTime  @default(now()) @map("created_at")
  deletedAt     DateTime? @map("deleted_at")

  // --------------------------------------------------------------------
  // İLİŞKİLER
  // --------------------------------------------------------------------
  // Kullanıcı - Çoktan bire ilişki (N Notification : 1 User)
  user          User      @relation(fields: [userId], references: [id])
  // Dava - Çoktan bire ilişki (N Notification : 1 Case) - opsiyonel
  case          Case?     @relation(fields: [caseId], references: [id])

  @@index([userId]) // Kullanıcı ID ile arama
  @@index([caseId]) // Dava ID ile arama
  @@index([isRead]) // Okunmamış tebligatları bulma
  @@index([deadline]) // Yaklaşan süreleri bulma
  @@index([uetsAutoProcessAt]) // 5 gün kuralı için otomatik işleme
  @@map("notifications")
}

// Tebligat türü enum'u
enum NotificationType {
  DECISION // Ara karar
  HEARING // Duruşma bildirimi
  DEADLINE // Süreli bildirim
  DELEGATION // Tevkil bildirimi
  SYSTEM // Sistem bildirimi
}

// ============================================================================
// TEVKİL (DELEGATIONS) TABLOSU
// Açıklama: Avukatlar arası duruşma tevkillerini saklar
// Diğer tablolarla ilişkiler:
// - fromUser (N:1) - Tevkili gönderen avukat
// - toUser (N:1) - Tevkili alan avukat
// - case (N:1) - İlgili dava
// ============================================================================
model Delegation {
  id            String    @id @default(uuid())
  
  // Gönderen ve alan avukatlar
  fromUserId    String    @map("from_user_id")
  toUserId      String?   @map("to_user_id") // Null = henüz kimse kabul etmedi
  
  // İlgili dava ve duruşma
  caseId        String?   @map("case_id")
  hearingDate   DateTime? @map("hearing_date")
  court         String? // Mahkeme adı
  
  // Durum ve not
  status        DelegationStatus @default(PENDING)
  message       String? // Gönderenin notu
  adminNote     String?   @map("admin_note") // Admin notu
  
  // Puanlama
  rating        Int? // 1-5 arası puan
  ratingComment String?   @map("rating_comment") // Puan yorumu
  
  // Yük dengeleme - Bu avukata ne kadar tevkil verildi
  fromUserDelegationCount Int @default(0) @map("from_user_delegation_count") // Bu kullanıcının gönderdiği toplam tevkil
  toUserDelegationCount   Int @default(0) @map("to_user_delegation_count") // Bu avukatın aldığı toplam tevkil (yük dengeleme için)

  // Zaman bilgileri
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  completedAt   DateTime? @map("completed_at")
  expiresAt     DateTime? @map("expires_at") // 24 saat sonra otomatik iptal
  deletedAt     DateTime? @map("deleted_at")

  // --------------------------------------------------------------------
  // İLİŞKİLER
  // --------------------------------------------------------------------
  // Gönderen - Çoktan bire ilişki (N Delegation : 1 User)
  fromUser      User      @relation("SentDelegations", fields: [fromUserId], references: [id])
  // Alan - Çoktan bire ilişki (N Delegation : 1 User) - opsiyonel
  toUser        User?     @relation("ReceivedDelegations", fields: [toUserId], references: [id])
  // Dava - Çoktan bire ilişki (N Delegation : 1 Case) - opsiyonel
  case          Case?     @relation(fields: [caseId], references: [id])
  // Şikayetler - Bire çok ilişki (N Delegation : N Complaint)
  complaints    Complaint[]

  @@index([fromUserId]) // Gönderen ID ile arama
  @@index([toUserId]) // Alan ID ile arama
  @@index([status]) // Durum ile arama
  @@index([expiresAt]) // Süresi dolan tevkilleri bulma
  @@map("delegations")
}

// Tevkil durumu enum'u
enum DelegationStatus {
  PENDING // Beklemede - tevkil gönderildi, henüz kabul edilmedi
  APPROVED // Onaylandı - tevkil kabul edildi
  REJECTED // Reddedildi - tevkil reddedildi
  CANCELLED // İptal edildi - gönderen iptal etti
  COMPLETED // Tamamlandı - duruşma yapıldı
}

// ============================================================================
// ŞİKAYET (COMPLAINTS) TABLOSU
// Açıklama: Tevkiller hakkında şikayetleri saklar
// ============================================================================
model Complaint {
  id            String    @id @default(uuid())
  delegationId  String    @map("delegation_id")
  filedById     String    @map("filed_by_id") // Şikayeti eden
  againstId     String    @map("against_id") // Şikayet edilen
  reason        ComplaintReason // Sebep
  description   String // Detaylı açıklama
  status        ComplaintStatus @default(PENDING) // pending, reviewed, resolved, dismissed
  
  // Admin değerlendirmesi
  adminNote     String?   @map("admin_note")
  resolvedAt    DateTime? @map("resolved_at")

  createdAt     DateTime  @default(now()) @map("created_at")

  // --------------------------------------------------------------------
  // İLİŞKİLER
  // --------------------------------------------------------------------
  // Tevkil - Çoktan bire ilişki (N Complaint : 1 Delegation)
  delegation    Delegation @relation(fields: [delegationId], references: [id])
  // Şikayet eden - Çoktan bire ilişki (N Complaint : 1 User)
  filedBy       User      @relation("ComplaintsFiled", fields: [filedById], references: [id])
  // Şikayet edilen - Çoktan bire ilişki (N Complaint : 1 User)
  against       User      @relation("ComplaintsAgainst", fields: [againstId], references: [id])

  @@index([delegationId])
  @@index([filedById])
  @@index([againstId])
  @@index([status])
  @@map("complaints")
}

enum ComplaintReason {
  NO_SHOW       // Duruşmaya gelmedi
  POOR_QUALITY  // Kötü takip
  LATE_RESPONSE // Geç cevap
  UNPROFESSIONAL // Uygunsuz davranış
  OTHER         // Diğer
}

enum ComplaintStatus {
  PENDING    // Beklemede
  REVIEWED   // İncelendi
  RESOLVED   // Çözüldü
  DISMISSED  // Reddedildi
}

// ============================================================================
// BELGE (DOCUMENTS) TABLOSU
// Açıklama: AI tarafından üretilen veya yüklenen belgeleri saklar
// Diğer tablolarla ilişkiler:
// - user (N:1) - Belgeyi oluşturan/indiren avukat
// - case (N:1) - İlgili dava (opsiyonel)
// ============================================================================
model Document {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  caseId        String?   @map("case_id")
  type          DocumentType // dilekçe, ihtarname, ara karar, diğer
  title         String // Belge başlığı
  content       String? // Belge içeriği (metin olarak)
  fileUrl       String?   @map("file_url") // Dosya URL'i (CloudFlare R2'de)
  fileSize      Int?      @map("file_size") // Dosya boyutu (byte)
  fileType      String?   @map("file_type") // Dosya tipi (pdf, docx, vs)
  status        DocumentStatus @default(DRAFT) // draft, approved, rejected
  aiModelUsed   String?   @map("ai_model_used") // Hangi AI ile oluşturuldu
  
  // İnsan onayı zorunluluğu (AI üretimi belgeler için)
  requiresApproval Boolean @default(true) @map("requires_approval") // AI üretimi ise true
  approvedBy     String?   @map("approved_by") // Onaylayan kullanıcı ID
  approvedAt     DateTime? @map("approved_at") // Onay tarihi

  // RAG için embedding durumu
  embedded      Boolean   @default(false) // Embedding oluşturuldu mu
  embeddingModel String?   @map("embedding_model") // Embedding modeli

  // İstatistikler
  wordCount     Int?      @map("word_count") // Kelime sayısı
  revisionCount Int       @default(0) @map("revision_count") // Revizyon sayısı

  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  // --------------------------------------------------------------------
  // İLİŞKİLER
  // --------------------------------------------------------------------
  // Kullanıcı - Çoktan bire ilişki (N Document : 1 User)
  user          User      @relation(fields: [userId], references: [id])
  // Dava - Çoktan bire ilişki (N Document : 1 Case) - opsiyonel
  case          Case?     @relation(fields: [caseId], references: [id])
  // Embedding'ler - Bire çok ilişki (1 Document : N DocumentEmbedding)
  embeddings    DocumentEmbedding[]

  @@index([userId]) // Kullanıcı ID ile arama
  @@index([caseId]) // Dava ID ile arama
  @@index([type]) // Belge türü ile arama
  @@index([status]) // Durum ile arama
  @@map("documents")
}

// Belge türü enum'u
enum DocumentType {
  PETITION // Dilekçe
  LEGAL_NOTICE // İhtarname
  DECISION // Ara karar
  CONTRACT // Sözleşme
  CORRESPONDENCE // Yazışma
  UDF // UDF formatında çıktı
  OTHER // Diğer
}

// Belge durumu enum'u
enum DocumentStatus {
  DRAFT // Taslak
  PENDING_REVIEW // İncelemede
  APPROVED // Onaylandı
  REJECTED // Reddedildi
}

// ============================================================================
// BELGE EMBEDDING (DOCUMENT_EMBEDDINGS) TABLOSU
// Açıklama: RAG sistemi için belgelerin vektör embedding'lerini saklar
// Pinecone vektör veritabanı ile senkronize çalışır
// ============================================================================
model DocumentEmbedding {
  id            String    @id @default(uuid())
  documentId    String    @map("document_id")
  caseId        String    @map("case_id") // Üst dava - daha hızlı sorgulama için

  // Embedding bilgileri
  vectorId      String    @map("vector_id") // Pinecone'daki vector ID
  chunkIndex    Int       @map("chunk_index") // Belgedeki chunk sırası (0, 1, 2, ...)
  chunkText     String    @map("chunk_text") // Chunk metni (arama için)
  
  // Embedding metadata
  model         String    @default("minimax-embedding") @map("embedding_model") // Embedding modeli
  dimensions    Int       @default(1536) @map("dimensions") // Vector boyutu
  tokenCount    Int       @map("token_count") // Bu chunk'ın token sayısı
  
  // Konum bilgisi (belge içinde)
  pageNumber    Int?      @map("page_number") // Sayfa numarası (PDF için)
  positionStart Int?      @map("position_start") // Belgedeki başlangıç pozisyonu

  createdAt     DateTime  @default(now()) @map("created_at")

  // --------------------------------------------------------------------
  // İLİŞKİLER
  // --------------------------------------------------------------------
  // Belge - Çoktan bire ilişki (N DocumentEmbedding : 1 Document)
  document      Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  // Dava - Çoktan bire ilişki (N DocumentEmbedding : 1 Case)
  case          Case      @relation(fields: [caseId], references: [id])

  @@index([documentId])
  @@index([caseId])
  @@index([vectorId])
  @@map("document_embeddings")
}

// ============================================================================
// HATIRLATICI (REMINDERS) TABLOSU
// Açıklama: Kullanıcıların oluşturduğu hatırlatıcıları saklar
// Diğer tablolarla ilişkiler:
// - user (N:1) - Hatırlatıcının sahibi
// - case (N:1) - İlgili dava (opsiyonel)
// - notification (N:1) - İlgili tebligat (opsiyonel)
// ============================================================================
model Reminder {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  caseId        String?   @map("case_id")
  notificationId String? @map("notification_id")
  type          ReminderType // Duruşma, süre, toplantı, genel
  title         String // Hatırlatıcı başlığı
  description   String? // Açıklama
  dueDate       DateTime  @map("due_date") // Hatırlatma tarihi
  remindAt      DateTime? @map("remind_at") // Hatırlatma zamanı
  
  // Bildirim türleri
  notifyTypes   ReminderNotifyType[] @default([PUSH, EMAIL]) @map("notify_types") // push, sms, email, whatsapp
  
  // Hatırlatıcı durumu
  status        ReminderStatus @default(ACTIVE)
  isCompleted   Boolean   @default(false) @map("is_completed")
  
  // Tekrar bilgisi (cronjob için)
  repeatType    String?   @map("repeat_type") // none, daily, weekly, monthly
  repeatInterval Int?     @map("repeat_interval") // Tekrar aralığı

  createdAt     DateTime  @default(now()) @map("created_at")
  completedAt   DateTime? @map("completed_at")

  // --------------------------------------------------------------------
  // İLİŞKİLER
  // --------------------------------------------------------------------
  // Kullanıcı - Çoktan bire ilişki (N Reminder : 1 User)
  user          User      @relation(fields: [userId], references: [id])
  // Dava - Çoktan bire ilişki (N Reminder : 1 Case) - opsiyonel
  case          Case?     @relation(fields: [caseId], references: [id])
  // Bildirim - Çoktan bire ilişki (N Reminder : 1 Notification) - opsiyonel
  notification  Notification? @relation(fields: [notificationId], references: [id])

  @@index([userId]) // Kullanıcı ID ile arama
  @@index([caseId]) // Dava ID ile arama
  @@index([dueDate]) // Tarih ile arama
  @@index([status]) // Durum ile arama
  @@map("reminders")
}

// Hatırlatıcı türü enum'u
enum ReminderType {
  HEARING // Duruşma hatırlatıcı
  DEADLINE // Süre hatırlatıcı
  MEETING // Toplantı hatırlatıcı
  GENERAL // Genel hatırlatıcı
}

// Hatırlatıcı bildirim türü enum'u
enum ReminderNotifyType {
  PUSH     // Push bildirim
  SMS      // SMS (NetGSM)
  EMAIL    // E-posta (SendGrid)
  WHATSAPP // WhatsApp
}

// Hatırlatıcı durumu enum'u
enum ReminderStatus {
  ACTIVE // Aktif
  COMPLETED // Tamamlandı
  CANCELLED // İptal edildi
}

// ============================================================================
// AI YAPILANDIRMA (AI_CONFIG) TABLOSU
// Açıklama: Her AI görevi için hangi modelin kullanılacağını saklar
// Admin panelden yapılandırılır
// ============================================================================
model AiConfig {
  id            String    @id @default(uuid())
  taskName      String    @unique @map("task_name") // Görev adı (örn: notification_summary)
  displayName   String?   @map("display_name") // Gösterim adı
  description   String? // Görev açıklaması
  model         AiModel   @default(MINIMAX) // minimax veya claude
  isActive      Boolean   @default(true) @map("is_active")
  priority      Int       @default(0) // Öncelik sırası
  settings      Json? // Ek ayarlar (temperature, max_tokens, vs)

  updatedAt     DateTime  @updatedAt @map("updated_at")
  updatedById   String?   @map("updated_by_id")

  // --------------------------------------------------------------------
  // İLİŞKİLER
  // --------------------------------------------------------------------
  // Güncelleyen - Çoktan bire ilişki (N AiConfig : 1 User)
  updatedBy     User?     @relation(fields: [updatedById], references: [id])

  @@map("ai_config")
}

// AI modeli enum'u
enum AiModel {
  MINIMAX // Minimax M2.7 Türkiye sunucusu
  CLAUDE // Claude (Sonnet)
}

// ============================================================================
// AI YAPILANDIRMA GÜNCELLEME (AI_CONFIG_UPDATE) TABLOSU
// Açıklama: AI yapılandırma değişikliklerinin geçişini saklar
// Diğer tablolarla ilişkiler:
// - config (N:1) - İlgili yapılandırma
// - updatedBy (N:1) - Değişikliği yapan kullanıcı
// ============================================================================
model AiConfigUpdate {
  id            String    @id @default(uuid())
  configId      String    @map("config_id")
  oldModel      String?   @map("old_model")
  newModel      String    @map("new_model")
  reason        String? // Değişiklik nedeni
  updatedById   String    @map("updated_by_id")
  createdAt     DateTime  @default(now()) @map("created_at")

  // --------------------------------------------------------------------
  // İLİŞKİLER
  // --------------------------------------------------------------------
  // Yapılandırma - Çoktan bire ilişki
  config        AiConfig  @relation(fields: [configId], references: [id])
  // Güncelleyen - Çoktan bire ilişki (N AiConfigUpdate : 1 User)
  updatedBy     User      @relation(fields: [updatedById], references: [id])

  @@map("ai_config_updates")
}

// ============================================================================
// TOKEN KULLANIMI (USER_TOKENS) TABLOSU
// Açıklama: Kullanıcıların aylık token kullanımını takip eder
// Diğer tablolarla ilişkiler:
// - user (N:1) - Token kullanan kullanıcı
// ============================================================================
model UserToken {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  tokenAmount   Int       @default(0) @map("token_amount") // Harcanan token sayısı
  aiModel       String    @map("ai_model") // Hangi modelde kullanıldı
  taskType      String    @map("task_type") // Görev türü
  periodStart   DateTime  @map("period_start") // Dönem başı
  periodEnd     DateTime  @map("period_end") // Dönem sonu

  createdAt     DateTime  @default(now()) @map("created_at")

  // --------------------------------------------------------------------
  // İLİŞKİLER
  // --------------------------------------------------------------------
  // Kullanıcı - Çoktan bire ilişki (N UserToken : 1 User)
  user          User      @relation(fields: [userId], references: [id])

  @@index([userId]) // Kullanıcı ID ile arama
  @@index([periodStart, periodEnd]) // Dönem ile arama
  @@map("user_tokens")
}

// ============================================================================
// UETS OTURUMU (UETS_SESSIONS) TABLOSU
// Açıklama: Kullanıcıların UETS bağlantı bilgilerini saklar
// Diğer tablolarla ilişkiler:
// - user (N:1) - Oturum sahibi
// ============================================================================
model UetsSession {
  id            String    @id @default(uuid())
  userId        String    @unique @map("user_id") // Her kullanıcının sadece bir aktif oturumu olabilir
  encryptedCredentials String @map("encrypted_credentials") // Şifrelenmiş UETS bilgileri
  sessionData   Json?     @map("session_data") // Ek oturum verileri (cookies, token, vs)
  lastSyncAt    DateTime? @map("last_sync_at") // Son senkronizasyon zamanı
  isActive      Boolean   @default(true) @map("is_active")
  
  // Oturum zaman aşımı
  expiresAt     DateTime? @map("expires_at") // UETS oturumunun expires zamanı
  
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // --------------------------------------------------------------------
  // İLİŞKİLER
  // --------------------------------------------------------------------
  // Kullanıcı - Çoktan bire ilişki (N UetsSession : 1 User)
  user          User      @relation(fields: [userId], references: [id])

  @@map("uets_sessions")
}

// ============================================================================
// DENETİM KAYITLARI (AUDIT_LOGS) TABLOSU
// Açıklama: Sistemdeki önemli işlemlerin geçmişini saklar
// Diğer tablolarla ilişkiler:
// - user (N:1) - İşlemi yapan kullanıcı (opsiyonel - sistem işlemleri için null olabilir)
// ============================================================================
model AuditLog {
  id            String    @id @default(uuid())
  userId        String?   @map("user_id")
  action        String // İşlem tipi (örn: LOGIN, CREATE_CASE, UPDATE_AI_CONFIG)
  entityType    String?   @map("entity_type") // Etkilenen tablo (users, cases, vs)
  entityId      String?   @map("entity_id") // Etkilenen kayıt ID'si
  oldValue      Json?     @map("old_value") // Eski değerler (JSON)
  newValue      Json?     @map("new_value") // Yeni değerler (JSON)
  ipAddress     String?   @map("ip_address") // İşlemi yapan IP
  userAgent     String?   @map("user_agent") // Tarayıcı bilgisi
  createdAt     DateTime  @default(now()) @map("created_at")

  // --------------------------------------------------------------------
  // İLİŞKİLER
  // --------------------------------------------------------------------
  // Kullanıcı - Çoktan bire ilişki (N AuditLog : 1 User) - opsiyonel
  user          User?     @relation(fields: [userId], references: [id])

  @@index([userId]) // Kullanıcı ID ile arama
  @@index([action]) // İşlem tipi ile arama
  @@index([entityType, entityId]) // Belirli kayıtların geçmişini bulma
  @@index([createdAt]) // Tarih ile arama
  @@map("audit_logs")
}
// ============================================================================
// ÖDEME (PAYMENTS) TABLOSU
// Açıklama: Ödeme işlemlerini saklar
// Diğer tablolarla ilişkiler:
// - user (N:1) - Ödeme yapan kullanıcı
// ============================================================================
model Payment {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  type          PaymentType @default(SUBSCRIPTION) @map("type") // Ödeme türü
  status        PaymentStatus @default(PENDING) @map("status") // Ödeme durumu
  provider      String?   // Ödeme sağlayıcısı (iyzico/paytr/stripe)
  transactionId String?   @map("transaction_id") // Sağlayıcıdaki işlem ID
  amount        Decimal   @db.Decimal(10,2) @map("amount") // Ödeme tutarı
  currency      String    @default("TRY") @map("currency") // Para birimi
  metadata      Json?     @map("metadata") // Ek veriler (paket tipi, period, vs)
  errorMessage  String?   @map("error_message") // Hata mesajı
  completedAt   DateTime? @map("completed_at") // Ödeme tamamlanma zamanı

  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // --------------------------------------------------------------------
  // İLİŞKİLER
  // --------------------------------------------------------------------
  // Kullanıcı - Çoktan bire ilişki (N Payment : 1 User)
  user          User      @relation(fields: [userId], references: [id])

  @@index([userId]) // Kullanıcı ID ile arama
  @@index([status]) // Durum ile arama
  @@index([provider]) // Sağlayıcı ile arama
  @@index([createdAt]) // Tarih ile arama
  @@map("payments")
}

// Ödeme türü enum'u
enum PaymentType {
  SUBSCRIPTION   // Abonelik ödemesi
  TOKEN_PACKAGE  // Token paketi satın alma
}

// Ödeme durumu enum'u
enum PaymentStatus {
  PENDING      // Beklemede
  COMPLETED    // Tamamlandı
  FAILED       // Başarısız
  REFUNDED     // İade edildi
  CANCELLED    // İptal edildi
}

// ============================================================================
// KULLANICI EVRAKLARI (USER_DOCUMENTS) TABLOSU
// Açıklama: Avukatların özlük dosyalarını saklar
// Kimlik, baro belgesi, vergi levhası gibi evraklar
// Diğer tablolarla ilişkiler:
// - user (N:1) - Evrak sahibi
// ============================================================================
model UserDocument {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  category      UserDocCategory @map("category") // Evrak kategorisi
  fileUrl       String    @map("file_url") // Dosya URL (R2'de)
  originalName  String    @map("original_name") // Orijinal dosya adı
  status        VerificationStatus @default(PENDING) @map("status") // Onay durumu
  verifiedBy    String?   @map("verified_by") // Onaylayan admin ID
  verifiedAt    DateTime? @map("verified_at") // Onay zamanı
  adminNotes    String?   @map("admin_notes") // Admin notları

  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // --------------------------------------------------------------------
  // İLİŞKİLER
  // --------------------------------------------------------------------
  // Kullanıcı - Çoktan bire ilişki (N UserDocument : 1 User)
  user          User      @relation(fields: [userId], references: [id])

  @@index([userId]) // Kullanıcı ID ile arama
  @@index([status]) // Durum ile arama
  @@index([category]) // Kategori ile arama
  @@map("user_documents")
}

// Evrak kategorisi enum'u
enum UserDocCategory {
  IDENTITY         // TC Kimlik fotokopisi
  BARO_CERTIFICATE // Baro kayıt belgesi
  TAX_PLAQUE       // Vergi levhası
  SIGNATURE_CIRCLE // İmza sirküleri
  DIPLOMA          // Diploma
  NOTARY_CONTRACT  // Noter sözleşmesi
  PROXY            // Vekilname
  OTHER            // Diğer
}

// Evrak onay durumu enum'u
enum VerificationStatus {
  PENDING   // Beklemede
  APPROVED  // Onaylandı
  REJECTED  // Reddedildi
  REVISION  // Revizyon istendi
}

// ============================================================================
// İCRA DOSYASI (ICRA_FILES) TABLOSU
// Açıklama: İcra takip dosyalarını saklar
// Diğer tablolarla ilişkiler:
// - user (N:1) - Takip sahibi avukat
// ============================================================================
model IcraFile {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  takipNumarasi String    @map("takip_numarasi") // İcra takip numarası
  alacakli      String    @map("alacakli") // Alacaklı (müvekkil)
  borclu        String    @map("borclu") // Borçlu
  borcluTC      String?   @map("borclu_tc") // Borçlu TC
  borcluAdres   String?   @map("borclu_adres") // Borçlu adresi
  takipTarihi   DateTime  @map("takip_tarihi") // Takip başlangıç tarihi
  takipTuru     IcraTrackingType @map("takip_turu") // Takip türü
  durum         IcraFileStatus @default(AKTIF) @map("durum") // Dosya durumu
  takipMiktari  Decimal   @db.Decimal(15,2) @map("takip_miktari") // Takip edilen miktar
  odemeMiktari  Decimal   @default(0) @db.Decimal(15,2) @map("odeme_miktari") // Ödenen miktar
  kalanMiktar   Decimal   @default(0) @db.Decimal(15,2) @map("kalan_miktar") // Kalan miktar
  satişTarihi   DateTime? @map("satis_tarihi") // Satış tarihi
  sonrakiAsama  String?   @map("sonraki_asama") // Sonraki aşama bilgisi
  aiAnaliz      Json?     @map("ai_analiz") // AI analiz sonucu
  aktif         Boolean   @default(true) @map("aktif") // Takip aktif mi
  kapatmaNedeni String?   @map("kapatma_nedeni") // Kapatma nedeni
  closedAt      DateTime? @map("closed_at") // Kapatma tarihi
  lastRefreshAt DateTime? @map("last_refresh_at") // Son güncelleme zamanı

  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at") // Soft delete

  // --------------------------------------------------------------------
  // İLİŞKİLER
  // --------------------------------------------------------------------
  user          User      @relation(fields: [userId], references: [id])
  reminders     Reminder[]
  documents     Document[]
  payments      IcraPayment[]

  @@unique([userId, takipNumarasi]) // Aynı kullanıcıda takip numarası benzersiz
  @@index([userId]) // Kullanıcı ID ile arama
  @@index([durum]) // Durum ile arama
  @@index([aktif]) // Aktif takipleri bulma
  @@map("icra_files")
}

// İcra takip türü enum'u
enum IcraTrackingType {
  ALACAK      // Alacak davası icrası
  TAKIP       // Genel icra takibi
  İSTİHKAK   // İstihkak iddiası
  HACİZ       // Haciz işlemleri
  SATIŞ       // Satış işlemleri
  TAHSİLAT    // Tahsilat takibi
}

// İcra dosya durumu enum'u
enum IcraFileStatus {
  AKTIF      // aktif takip
  KESİNLEŞEN // Kesinleşmiş
  SONA EREN   // Sona eren
  HACİZ       // Haciz aşamasında
  SATIŞ       // Satış aşamasında
  TAHSİLAT    // Tahsilat aşamasında
}

// ============================================================================
// İCRA TAHSİLAT (ICRA_PAYMENTS) TABLOSU
// Açıklama: İcra takiplerinden yapılan tahsilatları saklar
// Diğer tablolarla ilişkiler:
// - icraFile (N:1) - Tahsilatın ait olduğu icra dosyası
// ============================================================================
model IcraPayment {
  id            String    @id @default(uuid())
  icraFileId    String    @map("icra_file_id")
  amount        Decimal   @db.Decimal(15,2) @map("amount") // Tahsilat miktarı
  paymentDate   DateTime  @map("payment_date") // Ödeme tarihi
  description   String?   @map("description") // Açıklama
  status        PaymentStatus @default(PENDING) @map("status") // Ödeme durumu

  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // --------------------------------------------------------------------
  // İLİŞKİLER
  // --------------------------------------------------------------------
  icraFile      IcraFile  @relation(fields: [icraFileId], references: [id])

  @@index([icraFileId]) // İcra dosyası ile arama
  @@index([paymentDate]) // Tarih ile arama
  @@map("icra_payments")
}

// ============================================================================
// İCRA ARAMA KAYITLARI (ICRA_CALL_RECORDS) TABLOSU
// Açıklama: Borçlu arama kayıtlarını saklar
// Diğer tablolarla ilişkiler:
// - icraFile (N:1) - Aramanın ait olduğu icra dosyası
// - user (N:1) - Arayan avukat/operatör
// ============================================================================
model IcraCallRecord {
  id            String    @id @default(uuid())
  icraFileId    String    @map("icra_file_id")
  userId        String    @map("user_id")
  callResult    CallResult @map("call_result") // Arama sonucu
  callDirection CallDirection @default(OUTBOUND) @map("call_direction")
  notes         String?   @map("notes") // Görüşme notları
  paymentPromiseDate DateTime? @map("payment_promise_date") // Ödeme sözü tarihi
  paymentKept   Boolean   @default(false) @map("payment_kept") // Ödeme yapıldı mı
  
  createdAt     DateTime  @default(now()) @map("created_at")
  deletedAt     DateTime? @map("deleted_at") // Soft delete

  // --------------------------------------------------------------------
  // İLİŞKİLER
  // --------------------------------------------------------------------
  icraFile      IcraFile  @relation(fields: [icraFileId], references: [id])
  user          User      @relation(fields: [userId], references: [id])

  @@index([icraFileId]) // İcra dosyası ile arama
  @@index([userId]) // Kullanıcı ile arama
  @@index([callResult]) // Sonuç ile arama
  @@index([paymentPromiseDate]) // Ödeme sözü tarihi ile arama
  @@map("icra_call_records")
}

// Arama sonucu enum'u
enum CallResult {
  ANSWERED           // Cevap verdi
  NO_ANSWER          // Cevap vermedi
  BUSY               // Meşgul
  WRONG_NUMBER       // Yanlış numara
  PAYMENT_PROMISE    // Ödeme sözü
  REFUSED            // Reddetti
  CALLBACK_REQUESTED // Geri arama istedi
}

// Arama yönü enum'u
enum CallDirection {
  OUTBOUND  // Çıkış araması
  INBOUND    // Geliş araması
}

// ============================================================================
// İCRA MAL VARLIĞI GEÇMİŞİ (ICRA_ASSET_HISTORY) TABLOSU
// Açıklama: Mal varlığı tespit geçmişini saklar
// Diğer tablolarla ilişkiler:
// - icraFile (N:1) - Mal varlığının ait olduğu icra dosyası
// ============================================================================
model IcraAssetHistory {
  id            String    @id @default(uuid())
  icraFileId    String    @map("icra_file_id")
  assets        Json      @map("assets") // Mal varlıkları listesi
  totalValue    Decimal   @db.Decimal(15,2) @map("total_value") // Toplam değer
  notes         String?   @map("notes") // Notlar
  
  createdAt     DateTime  @default(now()) @map("created_at")

  // --------------------------------------------------------------------
  // İLİŞKİLER
  // --------------------------------------------------------------------
  icraFile      IcraFile  @relation(fields: [icraFileId], references: [id])

  @@index([icraFileId]) // İcra dosyası ile arama
  @@index([createdAt]) // Tarih ile arama
  @@map("icra_asset_history")
}

// ============================================================================
// BİLDİRİM ŞABLONU (NOTIFICATION_TEMPLATES) TABLOSU
// Açıklama: Tekrar kullanılabilir bildirim şablonları
// ============================================================================
model NotificationTemplate {
  id            String    @id @default(uuid())
  name          String    @map("name") // Şablon adı
  title         String    @map("title") // Başlık (değişkenlerle: {{name}})
  body          String    @map("body") // İçerik (değişkenlerle)
  channels      Json      @map("channels") // Hangi kanallarda kullanılabilir
  priority      String    @default("normal") @map("priority")
  isActive      Boolean   @default(true) @map("is_active")

  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("notification_templates")
}

// ============================================================================
// BİLDİRİM GÖNDERİM LOG (NOTIFICATION_LOGS) TABLOSU
// Açıklama: Gönderilen bildirimlerin geçmişini tutar
// ============================================================================
model NotificationLog {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  title         String    @map("title")
  body          String    @map("body")
  channels      Json      @map("channels") // Gönderilen kanallar
  
  // Push
  pushSent      Boolean   @default(false) @map("push_sent")
  pushMessageId String?   @map("push_message_id")
  pushError     String?   @map("push_error")
  
  // SMS
  smsSent       Boolean   @default(false) @map("sms_sent")
  smsMessageId  String?   @map("sms_message_id")
  smsError      String?   @map("sms_error")
  
  // Email
  emailSent     Boolean   @default(false) @map("email_sent")
  emailError    String?   @map("email_error")
  
  // WhatsApp
  whatsappSent Boolean   @default(false) @map("whatsapp_sent")
  whatsappError String?   @map("whatsapp_error")
  
  // Telegram
  telegramSent Boolean   @default(false) @map("telegram_sent")
  telegramError String?   @map("telegram_error")
  
  priority      String    @default("normal") @map("priority")
  
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([createdAt])
  @@map("notification_logs")
}
