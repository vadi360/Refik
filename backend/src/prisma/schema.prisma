// ============================================================================
// Refik Veritabanı Şeması (Prisma)
// Açıklama: Refik uygulamasının veritabanı yapısı - PostgreSQL
// 
// Şema Yapısı (23 Model):
// 1. User - Avukat kullanıcılar
// 2. Subscription - Abonelik bilgileri
// 3. Case - Dosya/dava bilgileri
// 4. Hearing - Duruşmalar
// 5. Notification - Tebligatlar (UETS)
// 6. Delegation - Tevkiller (duruşma devri)
// 7. Complaint - Tevkil şikayetleri
// 8. Document - Belgeler
// 9. DocumentEmbedding - RAG için vektör embeddings (Pinecone)
// 10. Reminder - Hatırlatıcılar
// 11. AiConfig - AI yapılandırma (görev bazlı model seçimi)
// 12. AiConfigUpdate - AI config değişiklik logu
// 13. UserToken - Token kullanım takibi
// 14. UetsSession - UETS oturum bilgileri
// 15. AuditLog - Denetim kayıtları
// 16. Payment - Ödemeler
// 17. UserDocument - Kullanıcı belgeleri (Kişisel dosyalar)
// 18. IcraFile - İcra dosyaları
// 19. IcraPayment - İcra ödemeleri
// 20. IcraCallRecord - İcra borçlu arama kayıtları
// 21. IcraAssetHistory - Mal varlığı tespit history
// 22. NotificationTemplate - Bildirim şablonları
// 23. NotificationLog - Bildirim gönderim logları
// 
// Not: Tüm field'lar Türkçe açıklamalarla belgelenmiştir
// ============================================================================

generator client {
  // Prisma Client oluşturucu ayarları
  // Çıktı klasörü: src/database/generated-client
  // Migration ve seed için prisma migrate kullanılır
  provider = "prisma-client-js"
}

datasource db {
  // PostgreSQL veritabanı bağlantı ayarları
  // DATABASE_URL environment değişkeninden okunur
  // Format: postgresql://user:password@host:5432/database
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// USER MODELİ
// Açıklama: Avukat kullanıcılarının temel bilgilerini saklar
// 
// İlişkiler:
// - subscriptions (1:N) - Her kullanıcının bir aboneliği olabilir
// - cases (1:N) - Her kullanıcının birden fazla dosyası olabilir
// - sentDelegations (1:N) - Gönderilen tevkiller
// - receivedDelegations (1:N) - Alınan tevkiller
// - notifications (1:N) - Kullanıcının tebligatları
// - documents (1:N) - Kullanıcının belgeleri
// - reminders (1:N) - Kullanıcının hatırlatıcılar
// - tokenUsage (1:N) - Token kullanım kayıtları
// - complaints (1:N, filed) - Kullanıcının yaptığı şikayetler
// - complaints (1:N, against) - Kullanıcıya yapılan şikayetler
// ============================================================================
model User {
  // -----------------------------------------------------------------------------
  // TEMEL KİŞİSEL BİLGİLER
  // -----------------------------------------------------------------------------
  
  // Benzersiz tanımlayıcı - UUID formatında otomatik oluşturulur
  // UUID: 128-bitlik benzersiz bir ID, dağıtık sistemlerde kullanılır
  id            String    @id @default(uuid())
  
  // E-posta adresi - kullanıcı girişi için kullanılır
  // @unique: Aynı e-posta ile birden fazla kayıt olamaz
  email         String    @unique
  
  // Şifre hash'i - bcrypt ile şifrelenmiş olarak saklanır
  // Güvenlik: 12 round bcrypt kullanılır
  passwordHash  String    @map("password_hash")
  
  // Ad soyad - profil görüntüleme ve tevkil başvurusu için
  name          String
  
  // Telefon numarası - OTP girişi ve bildirimler için
  // Opsiyonel: Bazı kullanıcılar e-posta ile giriş yapabilir
  // @unique: Aynı telefon numarası ile birden fazla kayıt olamaz
  phone         String?   @unique
  
  // Telefon doğrulama durumu - OTP ile doğrulandı mı?
  // Varsayılan: false (doğrulanmamış)
  phoneVerified Boolean   @default(false) @map("phone_verified")
  
  // Profil fotoğrafı URL'i - Gravatar veya yüklenen fotoğraf
  // Opsiyonel: Yüklenmezse varsayılan avatar gösterilir
  avatarUrl     String?   @map("avatar_url")

  // -----------------------------------------------------------------------------
  // MESLEKİ BİLGİLER
  // -----------------------------------------------------------------------------
  
  // Baro kayıt numarası - Türkiye'de avukatların zorunlu kaydı
  // TBB (Türkiye Barolar Birliği) sisteminden alınır
  baroReg       String?   @map("baro_reg")
  
  // Uzmanlık alanları dizisi - Hukuk alanları (iş hukuku, ceza hukuku vb.)
  // Örnek: ["iş hukuku", "ceza hukuku", "aile hukuku"]
  expertise     String[]  @default([])
  
  // Çalışma şehri - Tevkil pazarı için lokasyon bazlı eşleştirme
  city          String?
  
  // Çalışma ilçesi - Daha detaylı lokasyon
  district      String?
  
  // Çalışma adliyesi - Genellikle bulunduğu il veya ilçe mahkemesi
  court         String?

  // -----------------------------------------------------------------------------
  // YETKİ VE ROL SİSTEMİ
  // -----------------------------------------------------------------------------
  
  // Kullanıcı rolü - Sistem yetkilerini belirler
  // lawyer: Standart avukat, sadece kendi verilerine erişebilir
  // office_admin: Büro yöneticisi, ekip üyelerinin verilerini görebilir
  // super_admin: Sistem yöneticisi, tüm verilere erişebilir
  role          UserRole  @default(LAWYER)
  
  // Büro ID'si - Ekip yönetimi için kullanılır
  // office_admin rolündeki kullanıcılar bu ID altındaki ekibi yönetir
  officeId      String?   @map("office_id")

  // -----------------------------------------------------------------------------
  // PUANLAMA SİSTEMİ
  // -----------------------------------------------------------------------------
  
  // Ortalama puan - 0 ile 5 arasında ( virgülle 2 ondalık basamak )
  // Toplam puan / puan sayısı = ortalama
  rating        Decimal   @default(0) @db.Decimal(3,2)
  
  // Toplam puan sayısı - Kaç kişi puan vermiş (hesaplama için)
  ratingCount   Int       @default(0) @map("rating_count")

  // -----------------------------------------------------------------------------
  // ABONELİK DURUMU
  // -----------------------------------------------------------------------------
  
  // Abonelik durumu metni - "free", "basic", "standard", "professional", "enterprise"
  // Veritabanında enum yerine String kullanıldı (esneklik için)
  subscriptionStatus String   @default("free") @map("subscription_status")

  // -----------------------------------------------------------------------------
  // DOĞRULAMA DURUMU
  // -----------------------------------------------------------------------------
  
  // Admin onayı - Baro doğrulaması ve özlük dosyası kontrolü
  // false: Admin panelinde onay bekliyor
  // true: Onaylanmış, sisteme tam erişim
  isVerified     Boolean   @default(false) @map("is_verified")
  
  // Özlük dosyası URL'i - Barodan alınan onay belgesi
  // Admin panelinde görüntülenir ve onay için gereklidir
  verificationDoc String?   @map("verification_doc")

  // -----------------------------------------------------------------------------
  // KVKK ve AÇIK RIZA
  // -----------------------------------------------------------------------------
  
  // KVKK metni kabul edildi mi? - Zorunlu onay
  // 6698 sayılı Kişisel Verilerin Korunması Kanunu
  kvkkConsent   Boolean   @default(false) @map("kvkk_consent")
  
  // KVKK kabul tarihi - İleride sorun olursa kanıt olarak kullanılır
  kvkkConsentAt DateTime? @map("kvkk_consent_at")
  
  // Claude kullanımı için açık rıza - Ekstra AI hizmetleri için
  claudeConsent Boolean   @default(false) @map("claude_consent")
  
  // Claude rıza tarihi
  claudeConsentAt DateTime? @map("claude_consent_at")

  // -----------------------------------------------------------------------------
  // BİLDİRİM AYARLARI
  // -----------------------------------------------------------------------------
  
  // Firebase Cloud Messaging push token'ı - Anlık bildirimler için
  // Kullanıcı uygulamayı ilk açtığında alınır ve saklanır
  pushToken     String?   @map("push_token")
  
  // WhatsApp bildirimleri aktif mi?
  // true: Tebligat ve hatırlatıcılar WhatsApp'tan da gönderilir
  whatsappNotif Boolean   @default(false) @map("whatsapp_notif")
  
  // Telegram kullanıcı ID'si - Telegram bot üzerinden bildirim
  // Bot /start komutu çalıştırıldığında alınır
  telegramId    String?   @map("telegram_id")
  
  // Bildirim tercihleri (JSON formatında) - Her kanal için ayrı ayar
  // Örnek: { "push": true, "email": true, "sms": false, "whatsapp": true, "telegram": true }
  notificationPreferences Json?   @map("notification_preferences")

  // -----------------------------------------------------------------------------
  // ZAMAN BİLGİLERİ
  // -----------------------------------------------------------------------------
  
  // Kayıt oluşturulma tarihi - Otomatik olarak şimdiki zaman alınır
  createdAt     DateTime  @default(now()) @map("created_at")
  
  // Son güncelleme tarihi - Kayıt her değiştiğinde otomatik güncellenir
  updatedAt     DateTime  @updatedAt @map("updated_at")
  
  // Soft delete (geçici silme) - Veri fiziksel olarak silinmez
  // Sorgularda WHERE deletedAt IS NULL ile filtrelenir
  deletedAt     DateTime? @map("deleted_at")

  // -----------------------------------------------------------------------------
  // İLİŞKİLER (Relations)
  // -----------------------------------------------------------------------------
  
  // Abonelik - Bire çok ilişki (1 User : N Subscription)
  // Bir kullanıcının birden fazla subscription history olabilir
  // Ama sadece biri isActive=true olmalı
  subscriptions  Subscription[]
  
  // Dosyalar - Bire çok ilişki (1 User : N Case)
  // Avukat kendi dosyalarını görüntüler ve yönetir
  cases          Case[]
  
  // Bildirimler - Bire çok ilişki (1 User : N Notification)
  // Kullanıcıya gelen tebligatlar
  notifications  Notification[]
  
  // Belgeler - Bire çok ilişki (1 User : N Document)
  // Yüklenen ve oluşturulan belgeler
  documents      Document[]
  
  // Hatırlatıcılar - Bire çok ilişki (1 User : N Reminder)
  // Duruşma, süre, genel hatırlatıcılar
  reminders      Reminder[]
  
  // Gönderilen tevkiller - Bire çok ilişki
  // Kullanıcı başka bir avukata tevkil gönderdi
  sentDelegations Delegation[] @relation("SentDelegations")
  
  // Alınan tevkiller - Bire çok ilişki
  // Kullanıcı başkasından tevkil aldı
  receivedDelegations Delegation[] @relation("ReceivedDelegations")
  
  // Token kullanımı - Bire çok ilişki (1 User : N UserToken)
  // Her AI görevinde token tüketimi kaydedilir
  tokenUsage     UserToken[]
  
  // UETS oturumları - Bire çok ilişki (1 User : N UetsSession)
  // UETS'e her girişte yeni oturum kaydı oluşur
  uetsSessions   UetsSession[]
  
  // AI yapılandırma güncellemeleri - Bire çok ilişki (1 User : N AiConfigUpdate)
  // Admin config değişikliği yaptığında loglanır
  aiConfigUpdates AiConfigUpdate[]
  
  // Denetim kayıtları - Bire çok ilişki (1 User : N AuditLog)
  // Kritik işlemlerin logu (giriş, çıkış, ödeme vb.)
  auditLogs      AuditLog[]
  
  // Yapılan şikayetler - Bire çok ilişki
  // Kullanıcı başkasını şikayet etti
  complaintsFiled Complaint[] @relation("ComplaintsFiled")
  
  // Yapılan şikayetler (ters) - Bire çok ilişki
  // Başkası kullanıcıyı şikayet etti
  complaintsAgainst Complaint[] @relation("ComplaintsAgainst")

  // Kullanıcıya özel belgeler
  userDocuments   UserDocument[]

  // -----------------------------------------------------------------------------
  // İNDEKSLER (Performance optimization)
  // -----------------------------------------------------------------------------
  
  // E-posta ile hızlı arama (login için her seferinde kullanılır)
  @@index([email])
  
  // Telefon ile hızlı arama (OTP login için)
  @@index([phone])
  
  // Şehir ile arama (tevkil eşleştirme için)
  @@index([city])
  
  // Rol ile arama (admin sorguları için)
  @@index([role])
  
  // Tablo adı: "users"
  @@map("users")
}

// Kullanıcı rolü enum'u
// Not: PostgreSQL'de enum tipi olarak saklanır
enum UserRole {
  // Sıradan avukat - Kendi verilerine erişebilir
  LAWYER
  // Büro yöneticisi - Ekip üyelerinin verilerini görebilir ve yönetebilir
  OFFICE_ADMIN
  // Sistem yöneticisi - Tüm verilere erişim, sistem ayarları
  SUPER_ADMIN
}

// ============================================================================
// SUBSCRIPTION MODELİ
// Açıklama: Kullanıcıların abonelik bilgilerini saklar
// Her kullanıcının bir aktif aboneliği olabilir (isActive = true)
// 
// İlişkiler:
// - user (N:1) - Aboneliğin sahibi
// ============================================================================
model Subscription {
  // -----------------------------------------------------------------------------
  // TEMEL ALANLAR
  // -----------------------------------------------------------------------------
  
  // Benzersiz tanımlayıcı
  id            String    @id @default(uuid())
  
  // Kullanıcı ID'si - Hangi kullanıcıya ait olduğu
  // NOT: Burada @unique YOK, çünkü bir kullanıcının birden fazla subscription
  // history olabilir (geçmiş paketler, iadeler vb.)
  userId        String    @map("user_id")
  
  // Paket tipi - Hangi plan seçilmiş
  // Enum değerleri: FREE, BASIC, STANDARD, PROFESSIONAL, ENTERPRISE
  packageType   SubscriptionPackage @default(BASIC)
  
  // Aylık token limiti - Pakete göre değişir
  // FREE: 100, BASIC: 500, STANDARD: 2000, PROFESSIONAL: 10000, ENTERPRISE: sınırsız
  tokenLimit    Int       @map("token_limit")
  
  // Kullanılan token sayısı - Ay başında sıfırlanır (cron job ile)
  // Her AI görevinde recordTokenUsage() fonksiyonu ile güncellenir
  tokensUsed    Int       @default(0) @map("tokens_used")
  
  // Abonelik başlangıç tarihi
  startDate     DateTime  @map("start_date")
  
  // Abonelik bitiş tarihi - Bu tarihte otomatik yenileme veya iptal
  endDate       DateTime  @map("end_date")
  
  // Abonelik aktif mi? - true: kullanılabilir, false: iptal edilmiş/süresi dolmuş
  isActive      Boolean   @default(true) @map("is_active")
  
  // Otomatik yenileme - true: her ay otomatik ödeme
  // false: Manuel olarak yenilenmeli
  autoRenew     Boolean   @default(true) @map("auto_renew")
  
  // Kayıt oluşturulma tarihi
  createdAt     DateTime  @default(now()) @map("created_at")

  // Ödeme bilgileri (opsiyonel)
  paymentId     String?   @map("payment_id") // Ödeme kaydı ID'si
  paymentProvider String? @map("payment_provider") // iyzico, paytr, stripe

  // -----------------------------------------------------------------------------
  // İLİŞKİLER
  // -----------------------------------------------------------------------------
  
  // Kullanıcı - Çoktan bire ilişki (N Subscription : 1 User)
  // Her subscription bir kullanıcıya aittir
  user          User      @relation(fields: [userId], references: [id])

  // -----------------------------------------------------------------------------
  // İNDEKSLER
  // -----------------------------------------------------------------------------
  
  @@index([userId])
  @@index([isActive])
  
  @@map("subscriptions")
}

// Abonelik paketi enum'u
// Fiyatlar Türkiye pazarı için optimize edilmiştir
enum SubscriptionPackage {
  // Ücretsiz paket - Temel özellikler
  // - Tebligat takibi (sınırsız)
  // - Tevkil pazarı
  // - Takvim
  // - Hatırlatıcılar
  FREE
  
  // Basic paket - 199₺/ay
  // - FREE özellikleri +
  // - 500 token/ay
  // - AI özetleme (case_summary)
  BASIC
  
  // Standard paket - 499₺/ay
  // - BASIC özellikleri +
  // - 2000 token/ay
  // - UYAP entegrasyonu (dosya takibi)
  // - RAG arama (Pinecone)
  STANDARD
  
  // Professional paket - 999₺/ay
  // - STANDARD özellikleri +
  // - 10000 token/ay
  // - AI dilekçe hazırlama
  // - İhtarname üretimi
  // - Dilekçe revizyonu
  PROFESSIONAL
  
  // Enterprise paket - 1999₺/ay
  // - PROFESSIONAL özellikleri +
  // - Sınırsız token
  // - İçtihat araştırması (legal_research)
  // - İcra takibi
  // - B2B API erişimi
  ENTERPRISE
}

// ============================================================================
// CASE MODELİ
// Açıklama: Avukatların takip ettiği dava/dosya bilgileri
// 
// İlişkiler:
// - user (N:1) - Dosyanın sahibi avukat
// - hearings (1:N) - Dosyanın duruşmaları
// - notifications (1:N) - Dosyaya gelen tebligatlar
// - documents (1:N) - Dosyaya eklenen belgeler
// ============================================================================
model Case {
  // -----------------------------------------------------------------------------
  // TEMEL DOSYA BİLGİLERİ
  // -----------------------------------------------------------------------------
  
  // Benzersiz tanımlayıcı
  id            String    @id @default(uuid())
  
  // Dosya sahibi (avukat) ID'si
  userId        String    @map("user_id")
  
  // Dosya numarası - Mahkemelerdeki resmi numara
  // Format: "2024/1234 E." (E. = Esas numarası)
  caseNumber    String
  
  // Mahkeme adı - Örnek: "İstanbul Asliye Hukuk Mahkemesi"
  court         String?
  
  // Dosya türü - İş hukuku, ceza hukuku, aile hukuku vb.
  caseType      String?   @map("case_type")
  
  // Dosya konusu/başlığı - Kısa açıklama
  subject       String?
  
  // Dosya durumu - Açık, kapalı, bekleyen vb.
  status        CaseStatus @default(ACTIVE)
  
  // -----------------------------------------------------------------------------
  // DOSYA DETAYLARI (JSON olarak saklanır)
  // -----------------------------------------------------------------------------
  
  // Taraflar bilgisi - JSON array formatında
  // Örnek: [{"type": "davacı", "name": "Ahmet Yılmaz", "tc": "123..."}]
  parties       Json?
  
  // Dosya özeti - AI tarafından oluşturulan özet
  // notification_summary veya case_summary görevinden gelir
  aiSummary     String?   @map("ai_summary")
  
  // AI özet tarihi - Son güncelleme zamanı
  aiSummaryAt   DateTime? @map("ai_summary_at")
  
  // AI modeli - Özet hangi model ile oluşturuldu (minimax/claude)
  aiModel       String?   @map("ai_model")
  
  // -----------------------------------------------------------------------------
  // YAPILACAKLAR LİSTESİ (Case Update Modülü)
  // -----------------------------------------------------------------------------
  
  // AI tarafından önerilen yapılacaklar - JSON array
  // Her item: { "text": "Duruşma için dilekçe hazırla", "priority": "high", "dueDate": "..." }
  actionItems    Json?     @map("action_items")
  
  // Kronolojik kayıtlar - JSON array
  // Her item: { "date": "...", "event": "...", "source": "uyap/manual/ai" }
  timelineUpdates Json?    @map("timeline_updates")

  // -----------------------------------------------------------------------------
  // UYAP ENTEGRASYON
  // -----------------------------------------------------------------------------
  
  // UYAP dosya ID'si - UYAP sistemindeki resmi ID
  uyapFileId    String?   @map("uyap_file_id")
  
  // UYAP son sync zamanı
  uyapSyncedAt  DateTime? @map("uyap_synced_at")

  // -----------------------------------------------------------------------------
  // OTOMATİŞ İŞLEME (5 GÜN KURALI)
  // -----------------------------------------------------------------------------
  
  // UETS otomatik işlem zamanı - 5 gün kuralı için
  // Bu tarihte cron job otomatik olarak işlem yapacak
  // Format: createdAt + 5 iş günü
  uetsAutoProcessAt DateTime? @map("uets_auto_process_at")
  
  // 5 gün kuralı işlendi mi? - Tekrar işlenmemesi için flag
  uetsAutoProcessed Boolean   @default(false) @map("uets_auto_processed")

  // -----------------------------------------------------------------------------
  // ZAMAN BİLGİLERİ
  // -----------------------------------------------------------------------------
  
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  // -----------------------------------------------------------------------------
  // İLİŞKİLER
  // -----------------------------------------------------------------------------
  
  // Sahip - Çoktan bire ilişki (N Case : 1 User)
  user          User      @relation(fields: [userId], references: [id])
  
  // Duruşmalar - Bire çok ilişki (1 Case : N Hearing)
  hearings      Hearing[]
  
  // Bildirimler - Bire çok ilişki (1 Case : N Notification)
  notifications Notification[]
  
  // Belgeler - Bire çok ilişki (1 Case : N Document)
  documents      Document[]

  // -----------------------------------------------------------------------------
  // İNDEKSLER
  // -----------------------------------------------------------------------------
  
  @@index([userId])
  @@index([caseNumber])
  @@index([status])
  @@index([uyapFileId])
  
  @@map("cases")
}

// Dosya durumu enum'u
enum CaseStatus {
  // Dosya aktif, takip devam ediyor
  ACTIVE
  // Dosya kapatıldı (mahkeme karar verdi)
  CLOSED
  // Beklemede (karar bekleniyor)
  PENDING
  // Dosya askıda (duraklatıldı)
  SUSPENDED
}

// ============================================================================
// HEARING (DURUŞMA) MODELİ
// Açıklama: Mahkeme duruşma bilgileri
// 
// İlişkiler:
// - case (N:1) - Hangi dosyaya ait olduğu
// ============================================================================
model Hearing {
  // Benzersiz tanımlayıcı
  id            String    @id @default(uuid())
  
  // Dosya ID'si - Hangi case'e ait olduğu
  caseId        String    @map("case_id")
  
  // Duruşma tarihi ve saati
  hearingDate   DateTime  @map("hearing_date")
  
  // Duruşma saati (saat:dakika formatında)
  hearingTime   String?   @map("hearing_time")
  
  // Duruşma yeri - Salon numarası veya adı
  location      String?
  
  // Duruşma durumu - Yapıldı, ertelendi, bekliyor vb.
  status        HearingStatus @default(SCHEDULED)
  
  // Duruşma sonucu - Gelecek duruşma, karar, erteleme vb.
  result        String?
  
  // Duruşma notu - Avukatın kendi notu
  notes         String?
  
  // AI tarafından çıkarılan özet - Duruşma öncesi not
  aiSummary     String?   @map("ai_summary")

  // -----------------------------------------------------------------------------
  // İLİŞKİLER
  // -----------------------------------------------------------------------------
  
  // Dosya - Çoktan bire ilişki (N Hearing : 1 Case)
  // Dosya silinirse duruşmalar da silinir (Cascade)
  case          Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)

  // -----------------------------------------------------------------------------
  // İNDEKSLER
  // -----------------------------------------------------------------------------
  
  @@index([caseId])
  @@index([hearingDate])
  
  @@map("hearings")
}

// Duruşma durumu enum'u
enum HearingStatus {
  // Planlanmış - Gelecek duruşma
  SCHEDULED
  // Yapıldı - Duruşma gerçekleşti
  HELD
  // Ertelendi - Sonraki tarihe ertelendi
  POSTPONED
  // İptal edildi - Mahkeme iptal etti
  CANCELLED
}

// ============================================================================
// NOTIFICATION (TEBLİGAT) MODELİ
// Açıklama: UETS'ten gelen tebligatlar ve bildirimler
// 5 gün kuralı otomasyonu için kritik model
// 
// İlişkiler:
// - user (N:1) - Kime gönderildi
// - case (N:1) - Hangi dosyaya ait
// ============================================================================
model Notification {
  // Benzersiz tanımlayıcı
  id            String    @id @default(uuid())
  
  // Kullanıcı ID'si - Tebligat kime geldi
  userId        String    @map("user_id")
  
  // Dosya ID'si - Hangi case ile ilgili
  caseId        String    @map("case_id")
  
  // Tebligat türü - ihbar, karar, davet vb.
  type          NotificationType @default(GENERAL)
  
  // Tebligat başlığı/konusu
  subject       String
  
  // Tebligat içeriği - Detaylı metin
  content       String?
  
  // Gönderen kurum - Mahkeme, icra dairesi vb.
  sender        String?
  
  // Tebligat tarihi - UETS'ten geldiği tarih
  notificationDate DateTime @map("notification_date")
  
  // Tebligat numarası - UETS'teki resmi numara
  notificationNumber String? @map("notification_number")
  
  // Okundu mu? - false: yeni tebligat, true: görüldü
  isRead        Boolean   @default(false) @map("is_read")
  
  // Okunma tarihi
  readAt        DateTime? @map("read_at")
  
  // AI özet - notification_summary görevinden gelir
  // Kullanıcı tebligatı açtığında AI otomatik özet çıkarır
  aiSummary     String?   @map("ai_summary")
  
  // AI süre çıkarımı - deadline_extract görevinden gelir
  // Örnek: "15 gün içinde cevap verilmeli"
  aiDeadline    String?   @map("ai_deadline")
  
  // 5 gün kuralı son tarihi - notificationDate + 5 iş günü
  // Bu tarihte otomatik hatırlatıcı oluşturulur
  deadline5Days DateTime? @map("deadline_5_days")
  
  // Hatırlatıcı oluşturuldu mu?
  reminderCreated Boolean @default(false) @map("reminder_created")
  
  // Kaynak - uets, manual, email
  source        String    @default("uets")

  // -----------------------------------------------------------------------------
  // İLİŞKİLER
  // -----------------------------------------------------------------------------
  
  // Kullanıcı - Çoktan bire ilişki (N Notification : 1 User)
  user          User      @relation(fields: [userId], references: [id])
  
  // Dosya - Çoktan bire ilişki (N Notification : 1 Case)
  case          Case      @relation(fields: [caseId], references: [id])

  // -----------------------------------------------------------------------------
  // İNDEKSLER
  // -----------------------------------------------------------------------------
  
  @@index([userId])
  @@index([caseId])
  @@index([notificationDate])
  @@index([deadline5Days])
  
  @@map("notifications")
}

// Tebligat türü enum'u
enum NotificationType {
  // Genel tebligat
  GENERAL
  // İhbar - Tarafı bilgilendirme
  IHBAR
  // Karar - Mahkeme kararı
  DECISION
  // Davet - Duruşma daveti
  SUMMON
  // İcra - İcra takibi
  ICRA
  // Diğer
  OTHER
}

// ============================================================================
// DELEGATION (TEVKİL) MODELİ
// Açıklama: Avukatlar arası duruşma devri (tevkil)
// 
// İlişkiler:
// - sentBy (N:1) - Gönderen avukat
// - receivedBy (N:1) - Alan avukat
// - complaints (1:N) - Şikayetler
// ============================================================================
model Delegation {
  // Benzersiz tanımlayıcı
  id            String    @id @default(uuid())
  
  // -----------------------------------------------------------------------------
  // TEVKİL BİLGİLERİ
  // -----------------------------------------------------------------------------
  
  // Gönderen avukat ID'si - Duruşmayı devreden
  sentById      String    @map("sent_by_id")
  
  // Alan avukat ID'si - Duruşmayı devralan
  receivedById  String    @map("received_by_id")
  
  // Dosya ID'si - Hangi case devredildi
  caseId        String    @map("case_id")
  
  // Dosya numarası - Görüntüleme için
  caseNumber    String?   @map("case_number")
  
  // Duruşma tarihi - Devredilen duruşma
  hearingDate   DateTime? @map("hearing_date")
  
  // Duruşma yeri - Mahkeme salonu
  location      String?
  
  // -----------------------------------------------------------------------------
  // TEVKİL DURUMU
  // -----------------------------------------------------------------------------
  
  // Durum: pending, accepted, rejected, cancelled
  status        DelegationStatus @default(PENDING)
  
  // Açıklama - Neden tevkil edildiği
  description   String?
  
  // Ücret teklifi - TL cinsinden
  // null: Ücretsiz teklif
  // değer: Bu ücret karşılığında devir
  fee           Decimal?  @db.Decimal(10,2)
  
  // Ücret kabul edildi mi?
  feeAccepted   Boolean?  @default(false) @map("fee_accepted")
  
  // -----------------------------------------------------------------
  // KARŞILIKLI DEĞERLENDİRME (PUANLAMA)
  // -----------------------------------------------------------------
  
  // Gönderenin alana puanı (1-5)
  sentByRating  Int?      @map("sent_by_rating")
  
  // Alanın gönderene puanı (1-5)
  receivedByRating Int?   @map("received_by_rating")
  
  // Gönderenin yorumu
  sentByComment String?  @map("sent_by_comment")
  
  // Alanın yorumu
  receivedByComment String? @map("received_by_comment")
  
  // Kabul/reddetme tarihi
  respondedAt   DateTime? @map("responded_at")
  
  // İptal sebebi
  cancelReason  String?  @map("cancel_reason")

  // -----------------------------------------------------------------------------
  // İLİŞKİLER
  // -----------------------------------------------------------------------------
  
  // Gönderen - Çoktan bire ilişki (N Delegation : 1 User)
  sentBy        User      @relation("SentDelegations", fields: [sentById], references: [id])
  
  // Alan - Çoktan bire ilişki (N Delegation : 1 User)
  receivedBy    User      @relation("ReceivedDelegations", fields: [receivedById], references: [id])
  
  // Şikayetler - Bire çok ilişki
  complaints    Complaint[]

  // -----------------------------------------------------------------------------
  // İNDEKSLER
  // -----------------------------------------------------------------------------
  
  @@index([sentById])
  @@index([receivedById])
  @@index([status])
  
  @@map("delegations")
}

// Tevkil durumu enum'u
enum DelegationStatus {
  // Beklemede - Gönderildi, yanıt bekleniyor
  PENDING
  // Kabul edildi - Alan kabul etti
  ACCEPTED
  // Reddedildi - Alan reddetti
  REJECTED
  // İptal - Gönderen iptal etti
  CANCELLED
}

// ============================================================================
// COMPLAINT (ŞİKAYET) MODELİ
// Açıklama: Tevkil ile ilgili şikayetler
// 
// İlişkiler:
// - filedBy (N:1) - Şikayet eden
// - against (N:1) - Şikayet edilen
// - delegation (N:1) - İlgili tevkil
// ============================================================================
model Complaint {
  // Benzersiz tanımlayıcı
  id            String    @id @default(uuid())
  
  // Şikayet eden kullanıcı ID'si
  filedById     String    @map("filed_by_id")
  
  // Şikayet edilen kullanıcı ID'si
  againstId     String    @map("against_id")
  
  // İlgili tevkil ID'si
  delegationId  String    @map("delegation_id")
  
  // Şikayet sebebi
  reason        ComplaintReason
  
  // Şikayet açıklaması - Detaylı anlatım
  description   String
  
  // Şikayet durumu - pending, resolved, dismissed
  status        ComplaintStatus @default(PENDING)
  
  // Admin notu - Yönetici çözüm notu
  adminNote     String?   @map("admin_note")
  
  // Çözüm tarihi
  resolvedAt    DateTime? @map("resolved_at")

  // -----------------------------------------------------------------------------
  // İLİŞKİLER
  // -----------------------------------------------------------------------------
  
  // Şikayet eden - Çoktan bire ilişki
  filedBy       User      @relation("ComplaintsFiled", fields: [filedById], references: [id])
  
  // Şikayet edilen - Çoktan bire ilişki
  against       User      @relation("ComplaintsAgainst", fields: [againstId], references: [id])
  
  // Tevkil - Çoktan bire ilişki
  delegation    Delegation @relation(fields: [delegationId], references: [id])

  // -----------------------------------------------------------------------------
  // İNDEKSLER
  // -----------------------------------------------------------------------------
  
  @@index([filedById])
  @@index([againstId])
  @@index([status])
  
  @@map("complaints")
}

// Şikayet sebebi enum'u
enum ComplaintReason {
  // Görüşmemezlik - Gelen tevkile cevap vermedi
  NO_RESPONSE
  // Geç yanıt - Çok geç cevap verdi
  LATE_RESPONSE
  // Kalitesiz hizmet - Beklentileri karşılamadı
  POOR_SERVICE
  // Dolandırıcılık - Para alıp işi yapmadı
  FRAUD
  // Uygunsuz davranış - Kötü muamele
  MISCONDUCT
  // Diğer
  OTHER
}

// Şikayet durumu enum'u
enum ComplaintStatus {
  // Beklemede - Admin incelemesi bekleniyor
  PENDING
  // Çözüldü - Olumlu sonuçlandı
  RESOLVED
  // Reddedildi - Şikayet haksız
  DISMISSED
}

// ============================================================================
// DOCUMENT (BELGE) MODELİ
// Açıklama: Dosyalara eklenen belgeler ve AI belgeleri
// 
// İlişkiler:
// - user (N:1) - Yükleyen
// - case (N:1) - Hangi case'e ait
// - embeddings (1:N) - Pinecone vector embeddings
// ============================================================================
model Document {
  // Benzersiz tanımlayıcı
  id            String    @id @default(uuid())
  
  // -----------------------------------------------------------------------------
  // BELGE BİLGİLERİ
  // -----------------------------------------------------------------------------
  
  // Dosya URL'i - Storage'daki dosya yolu (S3, GCS vb.)
  fileUrl       String    @map("file_url")
  
  // Orijinal dosya adı
  fileName      String    @map("file_name")
  
  // MIME type - pdf, docx, image vb.
  mimeType      String    @map("mime_type")
  
  // Dosya boyutu (byte)
  fileSize      Int       @map("file_size")
  
  // Belge türü -ai, uploaded, uyap
  type          DocumentType @default(UPLOADED)
  
  // Belge kategorisi - dilekçe, karar, sözleşme vb.
  category      String?
  
  // Belge başlığı
  title         String?
  
  // Açıklama
  description   String?
  
  // Durumu - active, archived, deleted
  status        DocumentStatus @default(ACTIVE)
  
  // AI ile indekslendi mi? (Pinecone)
  isIndexed     Boolean   @default(false) @map("is_indexed")
  
  // Pinecone namespace - Hangi vector space'e ait
  namespace     String?   @map("namespace")
  
  // Chunk sayısı - Kaç parçaya bölündü (RAG için)
  chunkCount    Int?      @map("chunk_count")

  // -----------------------------------------------------------------------------
  // İLİŞKİ BİLGİLERİ
  // -----------------------------------------------------------------------------
  
  // Sahip - Yükleyen kullanıcı ID'si
  userId        String?   @map("user_id")
  
  // Dosya ID'si - Hangi case'e ait
  caseId        String?   @map("case_id")

  // AI çıktısı mı? - true: AI tarafından oluşturuldu
  isAiGenerated Boolean   @default(false) @map("is_ai_generated")
  
  // AI görev ID'si - Hangi görevle oluşturuldu
  aiTaskId      String?   @map("ai_task_id")

  // -----------------------------------------------------------------------------
  // ZAMAN BİLGİLERİ
  // -----------------------------------------------------------------------------
  
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  // -----------------------------------------------------------------------------
  // İLİŞKİLER
  // -----------------------------------------------------------------------------
  
  // Sahibi - Çoktan bire ilişki (opsiyonel)
  user          User?     @relation(fields: [userId], references: [id])
  
  // Dosyası - Çoktan bire ilişki (opsiyonel)
  case          Case?     @relation(fields: [caseId], references: [id])
  
  // Vektör embeddings - Bire çok ilişki
  embeddings    DocumentEmbedding[]

  // -----------------------------------------------------------------------------
  // İNDEKSLER
  // -----------------------------------------------------------------------------
  
  @@index([userId])
  @@index([caseId])
  @@index([type])
  @@index([isIndexed])
  
  @@map("documents")
}

// Belge türü enum'u
enum DocumentType {
  // Kullanıcı yükledi
  UPLOADED
  // AI tarafından oluşturuldu
  AI_GENERATED
  // UYAP'tan çekildi
  UYAP
  // RAG çıktısı
  RAG_OUTPUT
}

// Belge durumu enum'u
enum DocumentStatus {
  // Aktif - kullanılabilir
  ACTIVE
  // Arşivlendi
  ARCHIVED
  // Silindi (soft delete)
  DELETED
}

// ============================================================================
// DOCUMENT EMBEDDING MODELİ
// Açıklama: RAG sistemi için belgelerin vektör embedding'leri
// Pinecone vektör veritabanında saklanır, bu model metadata tutar
// 
// İlişkiler:
// - document (N:1) - Hangi belge
// ============================================================================
model DocumentEmbedding {
  // Benzersiz tanımlayıcı
  id            String    @id @default(uuid())
  
  // Belge ID'si - Hangi belgeye ait
  documentId    String    @map("document_id")
  
  // Pinecone vector ID - Pinecone'daki unique ID
  pineconeId    String    @map("pinecone_id")
  
  // Embedding modeli - minimax-embedding, text-embedding-3-small vb.
  embeddingModel String   @default("minimax-embedding") @map("embedding_model")
  
  // Chunk index - Belge kaçıncı parçada (0, 1, 2...)
  chunkIndex    Int       @map("chunk_index")
  
  // Chunk boyutu (token sayısı)
  chunkSize     Int       @map("chunk_size")
  
  // Metadata - İsteğe bağlı ek bilgiler
  metadata       Json?

  // -----------------------------------------------------------------------------
  // İLİŞKİLER
  // -----------------------------------------------------------------------------
  
  // Belge - Çoktan bire ilişki (N Embedding : 1 Document)
  document      Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)

  // -----------------------------------------------------------------------------
  // İNDEKSLER
  // -----------------------------------------------------------------------------
  
  @@index([documentId])
  @@index([pineconeId])
  
  @@map("document_embeddings")
}

// ============================================================================
// REMINDER (HATIRLATICI) MODELİ
// Açıklama: Kullanıcı hatırlatıcıları - duruşma, süre, genel
// 
// İlişkiler:
// - user (N:1) - Kime ait
// ============================================================================
model Reminder {
  // Benzersiz tanımlayıcı
  id            String    @id @default(uuid())
  
  // Kullanıcı ID'si
  userId        String    @map("user_id")
  
  // Hatırlatıcı türü
  type          ReminderType
  
  // Hatırlatıcı başlığı
  title         String
  
  // Hatırlatıcı açıklaması
  description   String?
  
  // Hatırlatılacak tarih ve saat
  remindAt      DateTime  @map("remind_at")
  
  // Bildirim kanalları - JSON array
  // ["push", "sms", "email", "whatsapp", "telegram"]
  notifyChannels Json     @default(Json["push"]) @map("notify_channels")
  
  // Bildirim türü - once, daily, weekly
  notifyType    ReminderNotifyType @default(ONCE)
  
  // Hatırlatıcı oluşturulma kaynağı - manual, ai, uets
  source        String    @default("manual")
  
  // İlgili dosya ID'si (opsiyonel)
  caseId        String?   @map("case_id")
  
  // İlgili tebligat ID'si (opsiyonel)
  notificationId String?  @map("notification_id")
  
  // İlgili duruşma ID'si (opsiyonel)
  hearingId     String?   @map("hearing_id")
  
  // Durumu - pending, sent, cancelled, completed
  status        ReminderStatus @default(PENDING)
  
  // İlk bildirim gönderildi mi?
  firstSent     Boolean   @default(false) @map("first_sent")
  
  // Son bildirim zamanı
  lastSentAt    DateTime? @map("last_sent_at")
  
  // Kaç kez gönderildi
  sendCount     Int       @default(0) @map("send_count")
  
  // Gönderim hatası var mı?
  errorMessage  String?   @map("error_message")

  // -----------------------------------------------------------------------------
  // İLİŞKİLER
  // -----------------------------------------------------------------------------
  
  // Sahibi - Çoktan bire ilişki (N Reminder : 1 User)
  user          User      @relation(fields: [userId], references: [id])

  // -----------------------------------------------------------------------------
  // İNDEKSLER
  // -----------------------------------------------------------------------------
  
  @@index([userId])
  @@index([remindAt])
  @@index([status])
  
  @@map("reminders")
}

// Hatırlatıcı türü enum'u
enum ReminderType {
  // Duruşma hatırlatıcısı
  HEARING
  // Yasal süre hatırlatıcısı
  DEADLINE
  // Genel hatırlatıcı
  GENERAL
  // Ödeme hatırlatıcısı
  PAYMENT
  // Toplantı hatırlatıcısı
  MEETING
}

// Bildirim türü enum'u
enum ReminderNotifyType {
  // Sadece bir kez hatırla
  ONCE
  // Her gün hatırla (remindAt tarihine kadar)
  DAILY
  // Her hafta hatırla
  WEEKLY
}

// Hatırlatıcı durumu enum'u
enum ReminderStatus {
  // Beklemede - Henüz gönderilmedi
  PENDING
  // Gönderildi - Bildirim gönderildi
  SENT
  // İptal edildi - Kullanıcı iptal etti
  CANCELLED
  // Tamamlandı - Tarih geçti ve gönderildi
  COMPLETED
}

// ============================================================================
// AI CONFIG MODELİ
// Açıklama: AI görev yapılandırması - Admin panel üzerinden yönetilir
// Her AI görevi için hangi modelin kullanılacağı belirlenir
// ============================================================================
model AiConfig {
  // Benzersiz tanımlayıcı
  id            String    @id @default(uuid())
  
  // AI görev adı - notification_summary, deadline_extract vb.
  // @unique: Her görev için sadece bir config olabilir
  taskName      String    @unique @map("task_name")
  
  // Kullanılacak AI modeli - minimax veya claude
  model         AiModel   @default(MINIMAX)
  
  // Token limiti - Bu görev için aylık limit
  // null: Sınırsız (örneğin notification_summary)
  tokenLimit    Int?
  
  // Görev açıklaması - Admin panelinde gösterilir
  description   String?
  
  // Bu görev için System Prompt
  systemPrompt  String?   @map("system_prompt")
  
  // Görev aktif mi?
  isActive      Boolean   @default(true) @map("is_active")
  
  // Admin tarafından son güncelleme
  updatedBy     String?   @map("updated_by")
  
  updatedAt     DateTime  @updatedAt

  // -----------------------------------------------------------------------------
  // İLİŞKİLER
  // -----------------------------------------------------------------------------
  
  // Güncellemeler - Bire çok ilişki (her değişiklik loglanır)
  updates       AiConfigUpdate[]

  // -----------------------------------------------------------------------------
  // İNDEKSLER
  // -----------------------------------------------------------------------------
  
  @@map("ai_config")
}

// AI Model enum'u
enum AiModel {
  // Minimax M2.7 - Türkiye'de KVKK uyumlu, hızlı, ucuz
  MINIMAX
  // Claude Sonnet - Yüksek kalite, daha pahalı
  CLAUDE
}

// ============================================================================
// AI CONFIG UPDATE MODELİ
// Açıklama: AI config değişikliklerinin log kaydı
// ============================================================================
model AiConfigUpdate {
  // Benzersiz tanımlayıcı
  id            String    @id @default(uuid())
  
  // AI Config ID'si
  configId      String    @map("config_id")
  
  // Değişiklik yapan kullanıcı (admin)
  userId        String    @map("user_id")
  
  // Eski değerler (JSON)
  oldValue      Json      @map("old_value")
  
  // Yeni değerler (JSON)
  newValue      Json      @map("new_value")
  
  // Değişiklik sebebi
  reason        String?
  
  // Değişiklik tarihi
  createdAt     DateTime  @default(now())

  // -----------------------------------------------------------------------------
  // İLİŞKİLER
  // -----------------------------------------------------------------------------
  
  // AI Config - Çoktan bire ilişki (N Update : 1 Config)
  config        AiConfig  @relation(fields: [configId], references: [id])
  
  // Kullanıcı - Çoktan bire ilişki (N Update : 1 User)
  user          User      @relation(fields: [userId], references: [id])

  // -----------------------------------------------------------------------------
  // İNDEKSLER
  // -----------------------------------------------------------------------------
  
  @@index([configId])
  @@index([userId])
  
  @@map("ai_config_updates")
}

// ============================================================================
// USER TOKEN MODELİ
// Açıklama: AI kullanım takibi - Token tüketimi kayıtları
// ============================================================================
model UserToken {
  // Benzersiz tanımlayıcı
  id            String    @id @default(uuid())
  
  // Kullanıcı ID'si
  userId        String    @map("user_id")
  
  // AI modeli - minimax veya claude
  aiModel       String    @map("ai_model")
  
  // AI görev türü - notification_summary, case_summary vb.
  taskType      String    @map("task_type")
  
  // Tüketilen token sayısı
  tokenAmount   Int       @map("token_amount")
  
  // Maliyet (TL cinsinden) - Finansal raporlama için
  cost          Decimal?  @db.Decimal(10,4)
  
  // Dönem başlangıcı - Ay başı (token limit yenileme için)
  periodStart   DateTime  @map("period_start")
  
  // Dönem bitişi - Ay sonu
  periodEnd     DateTime  @map("period_end")

  // İlgili case ID'si (opsiyonel)
  caseId        String?   @map("case_id")
  
  // İşlem açıklaması
  description   String?

  // -----------------------------------------------------------------------------
  // İLİŞKİLER
  // -----------------------------------------------------------------------------
  
  // Kullanıcı - Çoktan bire ilişki (N Token : 1 User)
  user          User      @relation(fields: [userId], references: [id])

  // -----------------------------------------------------------------------------
  // İNDEKSLER
  // -----------------------------------------------------------------------------
  
  @@index([userId])
  @@index([periodStart])
  @@index([periodEnd])
  
  @@map("user_tokens")
}

// ============================================================================
// UETS SESSION MODELİ
// Açıklama: UETS oturum bilgileri - Avukat UETS'e giriş yapınca
// ============================================================================
model UetsSession {
  // Benzersiz tanımlayıcı
  id            String    @id @default(uuid())
  
  // Kullanıcı ID'si
  userId        String    @map("user_id")
  
  // UETS session ID
  uetsSessionId String?   @map("uets_session_id")
  
  // UETS kullanıcı TCKN
  uetsTckn      String?   @map("uets_tckn")
  
  // Başlangıç zamanı
  startedAt     DateTime  @map("started_at")
  
  // Bitiş zamanı
  endedAt       DateTime? @map("ended_at")
  
  // Son aktivite zamanı
  lastActivityAt DateTime @map("last_activity_at")
  
  // IP adresi
  ipAddress     String?   @map("ip_address")
  
  // User agent
  userAgent     String?   @map("user_agent")

  // -----------------------------------------------------------------------------
  // İLİŞKİLER
  // -----------------------------------------------------------------------------
  
  // Kullanıcı - Çoktan bire ilişki (N Session : 1 User)
  user          User      @relation(fields: [userId], references: [id])

  // -----------------------------------------------------------------------------
  // İNDEKSLER
  // -----------------------------------------------------------------------------
  
  @@index([userId])
  @@index([startedAt])
  
  @@map("uets_sessions")
}

// ============================================================================
// AUDIT LOG MODELİ
// Açıklama: Sistem denetim kayıtları - Kritik işlemlerin logu
// ============================================================================
model AuditLog {
  // Benzersiz tanımlayıcı
  id            String    @id @default(uuid())
  
  // İşlemi yapan kullanıcı
  userId        String?   @map("user_id")
  
  // İşlem türü - login, logout, payment, config_change vb.
  action        String
  
  // İşlem açıklaması
  description   String?
  
  // İşlem detayları (JSON)
  details       Json?
  
  // İşlem IP'si
  ipAddress     String?   @map("ip_address")
  
  // İşlem user agent'ı
  userAgent     String?   @map("user_agent")
  
  // Başarılı mı?
  success       Boolean   @default(true)
  
  // Hata mesajı (varsa)
  errorMessage  String?   @map("error_message")
  
  // İşlem zamanı
  createdAt     DateTime  @default(now())

  // -----------------------------------------------------------------------------
  // İLİŞKİLER
  // -----------------------------------------------------------------------------
  
  // Kullanıcı - Çoktan bire ilişki (opsiyonel)
  user          User?     @relation(fields: [userId], references: [id])

  // -----------------------------------------------------------------------------
  // İNDEKSLER
  // -----------------------------------------------------------------------------
  
  @@index([userId])
  @@index([action])
  @@index([createdAt])
  
  @@map("audit_logs")
}

// ============================================================================
// PAYMENT MODELİ
// Açıklama: Ödeme kayıtları - Abonelik ve token paketleri
// ============================================================================
model Payment {
  // Benzersiz tanımlayıcı
  id            String    @id @default(uuid())
  
  // Kullanıcı ID'si
  userId        String    @map("user_id")
  
  // -----------------------------------------------------------------------------
  // ÖDEME BİLGİLERİ
  // -----------------------------------------------------------------------------
  
  // Ödeme türü - subscription, token_package, delegation_fee
  type          PaymentType
  
  // Ödeme miktarı (TL)
  amount        Decimal   @db.Decimal(10,2)
  
  // İndirim tutarı
  discount      Decimal   @default(0) @db.Decimal(10,2)
  
  // Son ödeme tutarı (amount - discount)
  finalAmount   Decimal   @map("final_amount") @db.Decimal(10,2)
  
  // -----------------------------------------------------------------------------
  // ÖDEME DURUMU
  // -----------------------------------------------------------------------------
  
  // Durum - pending, completed, failed, refunded, cancelled
  status        PaymentStatus @default(PENDING)
  
  // Ödeme sağlayıcısı - iyzico, paytr, stripe
  provider      String?
  
  // Provider transaction ID
  providerTransactionId String? @map("provider_transaction_id")
  
  // Provider order ID
  providerOrderId String?  @map("provider_order_id")
  
  // -----------------------------------------------------------------------------
  // PAKET BİLGİLERİ
  // -----------------------------------------------------------------------------
  
  // Abonelik paketi (eğer type = subscription)
  packageType   SubscriptionPackage? @map("package_type")
  
  // Token paketi (eğer type = token_package)
  tokenPackage  String?   @map("token_package")
  
  // Token miktarı (eğer token paketi ise)
  tokenAmount   Int?      @map("token_amount")
  
  // -----------------------------------------------------------------------------
  // FATURA
  // -----------------------------------------------------------------------------
  
  // Fatura ID (opsiyonel)
  invoiceId     String?   @map("invoice_id")
  
  // Fatura kesildi mi?
  invoiced      Boolean   @default(false)
  
  // Fatura tarihi
  invoicedAt    DateTime? @map("invoiced_at")

  // -----------------------------------------------------------------------------
  // İADE
  // -----------------------------------------------------------------------------
  
  // İade edildi mi?
  isRefunded    Boolean   @default(false) @map("is_refunded")
  
  // İade tarihi
  refundedAt    DateTime? @map("refunded_at")
  
  // İade sebebi
  refundReason  String?   @map("refund_reason")
  
  // İade eden admin
  refundedBy    String?   @map("refunded_by")

  // -----------------------------------------------------------------------------
  // ZAMAN BİLGİLERİ
  // -----------------------------------------------------------------------------
  
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // -----------------------------------------------------------------------------
  // İNDEKSLER
  // -----------------------------------------------------------------------------
  
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  
  @@map("payments")
}

// Ödeme türü enum'u
enum PaymentType {
  // Abonelik ödemesi
  SUBSCRIPTION
  // Token paketi satın alma
  TOKEN_PACKAGE
  // Tevkil ücreti
  DELEGATION_FEE
}

// Ödeme durumu enum'u
enum PaymentStatus {
  // Beklemede - Ödeme başlatıldı ama tamamlanmadı
  PENDING
  // Tamamlandı - Başarılı ödeme
  COMPLETED
  // Başarısız - Ödeme reddedildi
  FAILED
  // İade edildi
  REFUNDED
  // İptal edildi
  CANCELLED
}

// ============================================================================
// USER DOCUMENT MODELİ
// Açıklama: Kullanıcının kişisel belgeleri (portfolyo, sertifikalar vb.)
// Case'e bağlı olmayan kişisel dosyalar
// ============================================================================
model UserDocument {
  // Benzersiz tanımlayıcı
  id            String    @id @default(uuid())
  
  // Sahip kullanıcı
  userId        String    @map("user_id")
  
  // Dosya URL'i
  fileUrl       String    @map("file_url")
  
  // Dosya adı
  fileName      String    @map("file_name")
  
  // MIME type
  mimeType      String    @map("mime_type")
  
  // Dosya boyutu (byte)
  fileSize      Int       @map("file_size")
  
  // Kategori - cv, sertifika, ruhsat, diploma, diğer
  category      UserDocCategory @default(OTHER)
  
  // Başlık
  title         String?
  
  // Açıklama
  description   String?
  
  // Görünürlük - private, public, shared
  visibility    String    @default("private")
  
  // Paylaşılan kullanıcılar (JSON array - user ID'leri)
  sharedWith    Json?     @map("shared_with")
  
  // -----------------------------------------------------------------
  // ONAY DURUMU (Özlük dosyası için)
  // -----------------------------------------------------------------
  
  // Admin onayı gerekiyor mu?
  requiresApproval Boolean @default(false) @map("requires_approval")
  
  // Onaylandı mı?
  isApproved    Boolean   @default(false) @map("is_approved")
  
  // Onaylanma tarihi
  approvedAt    DateTime? @map("approved_at")
  
  // Onaylayan admin
  approvedBy    String?   @map("approved_by")

  // -----------------------------------------------------------------------------
  // İLİŞKİLER
  // -----------------------------------------------------------------------------
  
  // Sahibi - Çoktan bire ilişki (N Doc : 1 User)
  user          User      @relation(fields: [userId], references: [id])

  // -----------------------------------------------------------------------------
  // İNDEKSLER
  // -----------------------------------------------------------------------------
  
  @@index([userId])
  @@index([category])
  
  @@map("user_documents")
}

// Kullanıcı belge kategorisi enum'u
enum UserDocCategory {
  // Özgeçmiş
  CV
  // Baro ruhsatı
  LICENSE
  // Sertifikalar
  CERTIFICATE
  // Diploma
  DIPLOMA
  // Referans mektubu
  REFERENCE
  // Kimlik fotokopisi
  ID_COPY
  // Diğer
  OTHER
}

// ============================================================================
// ICRA FILE MODELİ
// Açıklama: İcra takip dosyaları
// ============================================================================
model IcraFile {
  // Benzersiz tanımlayıcı
  id            String    @id @default(uuid())
  
  // -----------------------------------------------------------------------------
  // DOSYA BİLGİLERİ
  // -----------------------------------------------------------------------------
  
  // Kullanıcı ID'si - Takip eden avukat
  userId        String    @map("user_id")
  
  // Dosya numarası - İcra dosya numarası
  fileNumber    String    @map("file_number")
  
  // Takip türü - borclu, alacakli
  trackingType  IcraTrackingType @map("tracking_type")
  
  // Borçlu adı
  debtorName    String?   @map("debtor_name")
  
  // Borçlu TCKN
  debtorTckn    String?   @map("debtor_tckn")
  
  // Alacaklı adı
  creditorName  String?   @map("creditor_name")
  
  // Alacaklı TCKN
  creditorTckn  String?   @map("creditor_tckn")
  
  // Asıl alacak (TL)
  principalAmount Decimal? @map("principal_amount") @db.Decimal(12,2)
  
  // Faiz tutarı
  interestAmount Decimal? @map("interest_amount") @db.Decimal(12,2)
  
  // Toplam borç
  totalAmount   Decimal?  @map("total_amount") @db.Decimal(12,2)
  
  // -----------------------------------------------------------------------------
  // TAKİP DURUMU
  // -----------------------------------------------------------------------------
  
  // Durumu - active, paid, cancelled, transferred
  status        IcraFileStatus @default(ACTIVE)
  
  // İcra dairesi
  icraOffice    String?   @map("icra_office")
  
  // Dosya açılış tarihi
  fileOpenDate  DateTime? @map("file_open_date")
  
  // Tahsil edilen tutar
  collectedAmount Decimal  @default(0) @map("collected_amount") @db.Decimal(12,2)
  
  // Tahsil tarihi
  paidAt        DateTime? @map("paid_at")

  // -----------------------------------------------------------------------------
  // AI MAL VARLIĞI TESPİTİ
  // -----------------------------------------------------------------------------
  
  // Mal varlığı tespit edildi mi?
  assetsDetected Boolean  @default(false) @map("assets_detected")
  
  // Son tarama tarihi
  lastAssetScanAt DateTime? @map("last_asset_scan_at")
  
  // Tespit edilen varlıklar (JSON)
  detectedAssets  Json?    @map("detected_assets")

  // -----------------------------------------------------------------------------
  // İLİŞKİLER
  // -----------------------------------------------------------------------------
  
  // Ödemeler - Bire çok ilişki
  payments      IcraPayment[]
  
  // Arama kayıtları - Bire çok ilişki
  callRecords   IcraCallRecord[]
  
  // Mal varlığı history - Bire çok ilişki
  assetHistory  IcraAssetHistory[]

  // -----------------------------------------------------------------------------
  // İNDEKSLER
  // -----------------------------------------------------------------------------
  
  @@index([userId])
  @@index([fileNumber])
  @@index([status])
  
  @@map("icra_files")
}

// İcra takip türü enum'u
enum IcraTrackingType {
  // Borçlu takibi - Alacaklı adına takip
  BORCLU
  // Alacaklı takibi - Borçlu adına takip
  ALACAKLI
}

// İcra dosya durumu enum'u
enum IcraFileStatus {
  // Aktif - Takip devam ediyor
  ACTIVE
  // Ödendi - Borç tamamen ödendi
  PAID
  // İptal edildi
  CANCELLED
  // Başkasına devredildi
  TRANSFERRED
}

// ============================================================================
// ICRA PAYMENT MODELİ
// Açıklama: İcra ödeme kayıtları
// ============================================================================
model IcraPayment {
  // Benzersiz tanımlayıcı
  id            String    @id @default(uuid())
  
  // İcra dosya ID'si
  fileId        String    @map("file_id")
  
  // Ödeme tarihi
  paymentDate   DateTime  @map("payment_date")
  
  // Ödeme tutarı (TL)
  amount        Decimal   @db.Decimal(12,2)
  
  // Ödeme türü - nakit, havale, çek, senet
  paymentMethod String?   @map("payment_method")
  
  // Açıklama
  description   String?
  
  // Makbuz numarası
  receiptNumber String?   @map("receipt_number")

  // -----------------------------------------------------------------------------
  // İLİŞKİLER
  // -----------------------------------------------------------------------------
  
  // İcra dosyası - Çoktan bire ilişki (N Payment : 1 IcraFile)
  file          IcraFile  @relation(fields: [fileId], references: [id], onDelete: Cascade)

  // -----------------------------------------------------------------------------
  // İNDEKSLER
  // -----------------------------------------------------------------------------
  
  @@index([fileId])
  @@index([paymentDate])
  
  @@map("icra_payments")
}

// ============================================================================
// ICRA CALL RECORD MODELİ
// Açıklama: Borçlu arama kayıtları - Tahsilat için yapılan görüşmeler
// ============================================================================
model IcraCallRecord {
  // Benzersiz tanımlayıcı
  id            String    @id @default(uuid())
  
  // İcra dosya ID'si
  fileId        String    @map("file_id")
  
  // Arama yönü - outgoing, incoming
  direction     CallDirection @default(OUTGOING)
  
  // Arama tarihi ve saati
  calledAt      DateTime  @map("called_at")
  
  // Arama sonucu - cevap yok, meşgul, görüşüldü vb.
  result        CallResult
  
  // Görüşülen kişi
  contactName   String?   @map("contact_name")
  
  // Görüşülen kişi telefonu
  contactPhone  String?   @map("contact_phone")
  
  // Görüşme notu
  notes         String?
  
  // Ödeme sözü verildi mi?
  promiseAmount Decimal?  @map("promise_amount") @db.Decimal(12,2)
  
  // Ödeme sözü tarihi
  promiseDate   DateTime? @map("promise_date")

  // -----------------------------------------------------------------------------
  // İLİŞKİLER
  // -----------------------------------------------------------------------------
  
  // İcra dosyası - Çoktan bire ilişki (N Record : 1 IcraFile)
  file          IcraFile  @relation(fields: [fileId], references: [id], onDelete: Cascade)

  // -----------------------------------------------------------------------------
  // İNDEKSLER
  // -----------------------------------------------------------------------------
  
  @@index([fileId])
  @@index([calledAt])
  
  @@map("icra_call_records")
}

// Arama yönü enum'u
enum CallDirection {
  // Giden arama
  OUTGOING
  // Gelen arama
  INCOMING
}

// Arama sonucu enum'u
enum CallResult {
  // Cevap yok
  NO_ANSWER
  // Meşgul
  BUSY
  // Kapandı
  SWITCHED_OFF
  // Görüşüldü
  ANSWERED
  // Numara yanlış
  WRONG_NUMBER
  // Diğer
  OTHER
}

// ============================================================================
// ICRA ASSET HISTORY MODELİ
// Açıklama: Mal varlığı tespit history'si - AI taramalarının sonuçları
// ============================================================================
model IcraAssetHistory {
  // Benzersiz tanımlayıcı
  id            String    @id @default(uuid())
  
  // İcra dosya ID'si
  fileId        String    @map("file_id")
  
  // Tarama tarihi
  scannedAt     DateTime  @map("scanned_at")
  
  // AI modeli - Hangi model ile tarandı
  aiModel       String?   @map("ai_model")
  
  // Tespit edilen varlıklar (JSON)
  assets        Json
  
  // Toplam değer (TL)
  totalValue    Decimal?  @map("total_value") @db.Decimal(14,2)
  
  // Güvenilirlik oranı - AI güvenilirlik yüzdesi
  confidenceRate Decimal? @map("confidence_rate") @db.Decimal(5,2)
  
  // Tarama kaynağı - barkod, k pledgesearch, manual
  source        String    @default("ai_scan")
  
  // Notlar
  notes         String?

  // -----------------------------------------------------------------------------
  // İLİŞKİLER
  // -----------------------------------------------------------------------------
  
  // İcra dosyası - Çoktan bire ilişki (N History : 1 IcraFile)
  file          IcraFile  @relation(fields: [fileId], references: [id], onDelete: Cascade)

  // -----------------------------------------------------------------------------
  // İNDEKSLER
  // -----------------------------------------------------------------------------
  
  @@index([fileId])
  @@index([scannedAt])
  
  @@map("icra_asset_history")
}

// ============================================================================
// NOTIFICATION TEMPLATE MODELİ
// Açıklama: Bildirim şablonları - Email, SMS, Push için
// ============================================================================
model NotificationTemplate {
  // Benzersiz tanımlayıcı
  id            String    @id @default(uuid())
  
  // Şablon adı
  name          String
  
  // Şablon türü - email, sms, push, whatsapp, telegram
  type          String
  
  // Şablon başlığı (email için)
  subject       String?
  
  // Şablon içeriği - {{name}}, {{date}} gibi placeholder'lar
  content       String
  
  // Aktif mi?
  isActive      Boolean   @default(true) @map("is_active")
  
  // Şablon dili
  language      String    @default("tr")
  
  // Kategori - tebligat, hatırlatıcı, pazarlama, sistem
  category      String    @default("system")
  
  // Son kullanım tarihi (opsiyonel)
  expiresAt     DateTime? @map("expires_at")

  // -----------------------------------------------------------------------------
  // İNDEKSLER
  // -----------------------------------------------------------------------------
  
  @@index([type])
  @@index([isActive])
  
  @@map("notification_templates")
}

// ============================================================================
// NOTIFICATION LOG MODELİ
// Açıklama: Bildirim gönderim logları - Hangi bildirimler gönderildi
// ============================================================================
model NotificationLog {
  // Benzersiz tanımlayıcı
  id            String    @id @default(uuid())
  
  // Kullanıcı ID'si
  userId        String    @map("user_id")
  
  // Bildirim türü - push, sms, email, whatsapp, telegram
  channel       String
  
  // Bildirim başlığı
  title         String?
  
  // Bildirim içeriği
  content       String?
  
  // Gönderim durumu - sent, failed, pending
  status        String    @default("pending")
  
  // Provider message ID (SMS, Push vb.)
  providerMessageId String? @map("provider_message_id")
  
  // Gönderim zamanı
  sentAt        DateTime? @map("sent_at")
  
  // Okunma zamanı (push için)
  readAt        DateTime? @map("read_at")
  
  // Hata mesajı (varsa)
  errorMessage  String?   @map("error_message")
  
  // İlgili reminder ID (varsa)
  reminderId    String?   @map("reminder_id")
  
  // İlgili notification ID (varsa)
  notificationId String?  @map("notification_id")

  // -----------------------------------------------------------------------------
  // İNDEKSLER
  // -----------------------------------------------------------------------------
  
  @@index([userId])
  @@index([channel])
  @@index([status])
  @@index([sentAt])
  
  @@map("notification_logs")
}

