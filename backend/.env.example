# ============================================================================
# AvukatPro Backend - Environment Değişkenleri (.env.example)
# Açıklama: Backend'in çalışması için gerekli environment değişkenleri
# 
# Kullanım:
# 1. Bu dosyayı .env olarak kopyalayın
# 2. Değerleri gerçek değerlerle doldurun
# 3. Hassas bilgileri (API key'ler, şifreler) asla versiyon kontrolüne atmayın
# ============================================================================

# ============================================================================
# UYGULAMA AYARLARI
# ============================================================================

# Uygulama ortamı: development, production, test
NODE_ENV=development

# Uygulama portu (varsayılan: 3000)
PORT=3000

# Sunucu host'u (varsayılan: 0.0.0.0)
HOST=0.0.0.0

# ============================================================================
# VERİTABANI (PostgreSQL)
# ============================================================================

# PostgreSQL bağlantı URL'i
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Örnek: postgresql://avukatpro:securepass123@localhost:5432/avukatpro_db
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# ============================================================================
# REDIS (Cache & Queue)
# ============================================================================

# Redis bağlantı URL'i
# Örnek: redis://localhost:6379
REDIS_URL=redis://localhost:6379

# ============================================================================
# JWT (Kimlik Doğrulama)
# ============================================================================

# JWT signing secret - güvenli ve tahmin edilemez bir değer olmalı
# Production'da en az 32 karakterlik rastgele bir string kullanın
# Oluşturmak için: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Access token süresi (varsayılan: 1h)
JWT_EXPIRES_IN=1h

# Refresh token secret - access token'dan farklı olmalı
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production

# Refresh token süresi (varsayılan: 7d)
JWT_REFRESH_EXPIRES_IN=7d

# ============================================================================
# AI API'LERİ
# ============================================================================

# Minimax API (Türkiye sunucusu - KVKK uyumlu)
# API anahtarını Minimax panelinden alın
MINIMAX_API_KEY=your-minimax-api-key

# Minimax API URL'i (Türkiye sunucusu)
MINIMAX_API_URL=https://api.minimax.chat/v1

# Claude API (Anthropic)
# API anahtarını Anthropic panelinden alın
CLAUDE_API_KEY=your-claude-api-key

# Claude API URL'i
CLAUDE_API_URL=https://api.anthropic.com/v1

# ============================================================================
# CLOUD STORAGE (CloudFlare R2)
# ============================================================================

# CloudFlare R2 hesap bilgileri
# R2 dashboard'undan alınabilir
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY=your-r2-access-key
R2_SECRET_KEY=your-r2-secret-key

# R2 bucket adı (AvukatPro için oluşturulan bucket)
R2_BUCKET=avukatpro-documents

# R2 public URL (bucket'ın public URL'i)
R2_PUBLIC_URL=https://pub-xxx.r2.dev

# ============================================================================
# SMS (NetGSM)
# ============================================================================

# NetGSM API bilgileri
# NetGSM panelinden alınabilir: https://www.netgsm.com.tr
NETGSM_USER=your-netgsm-username
NETGSM_PASS=your-netgsm-password

# SMS başlığı (kayıtlı başlık)
NETGSM_ORGINATOR=AVUKATPRO

# ============================================================================
# EMAIL (SendGrid)
# ============================================================================

# SendGrid API anahtarı
# SendGrid panelinden alınabilir: https://app.sendgrid.com
SENDGRID_API_KEY=your-sendgrid-api-key

# Gönderen e-posta adresi
SENDGRID_FROM_EMAIL=info@avukatpro.com

# ============================================================================
# RATE LIMITING
# ============================================================================

# Rate limit penceresi (milisaniye)
# 60000 = 60 saniye
THROTTLE_TTL=60000

# Rate limit - pencere başına max istek sayısı
THROTTLE_LIMIT=100

# ============================================================================
# CORS (Frontend Bağlantısı)
# ============================================================================

# İzin verilen frontend origin'leri
# Virgülle ayrılmış şekilde birden fazla origin eklenebilir
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://avukatpro.com

# ============================================================================
# SWAGGER
# ============================================================================

# Swagger'ı production'da kapatmak için
SWAGGER_ENABLED=true

# ============================================================================
# LOGGING
# ============================================================================

# Log seviyesi: error, warn, info, debug
LOG_LEVEL=info

# ============================================================================
# NOTLAR
# ============================================================================
# 
# 1. Bu dosyayı .env olarak kopyalayın
# 2. Tüm değerleri gerçek değerlerle doldurun
# 3. .env dosyasını .gitignore'a ekleyin
# 4. Production'da environment değişkenlerini güvenli bir şekilde yönetin
# 
# Güvenlik Notları:
# - API key'ler ve şifreler asla versiyon kontrolüne atılmamalı
# - Production'da secret'ları environment olarak değil, secret manager kullanın
# - JWT secret'ları production'da mutlaka değiştirin