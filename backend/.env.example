# ============================================================================
// AvukatPro Backend - Environment Değişkenleri Şablonu
// Açıklama: Geliştirme ve production ortamları için gerekli
// tüm environment değişkenlerini içerir
// 
// Kullanım:
// 1. Bu dosyayı .env olarak kopyalayın
// 2. Değerleri gerçek değerlerle doldurun
// 3. Hiçbir zaman .env dosyasını Git'e commit etmeyin!
// ============================================================================

# ============================================================================
// UYGULAMA AYARLARI
// ============================================================================

# Uygulama modu: development, production, test
NODE_ENV=development

# Uygulama portu (varsayılan: 3000)
PORT=3000

# Sunucu host'u (varsayılan: 0.0.0.0)
HOST=0.0.0.0

# API base URL (frontend ve e-postalarda kullanılır)
APP_URL=http://localhost:3000

# ============================================================================
// VERİTABANI (PostgreSQL)
// ============================================================================

# PostgreSQL bağlantı string'i
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:password@localhost:5432/avukatpro

# ============================================================================
// REDIS (Cache + Session)
// ============================================================================

# Redis bağlantı URL'i
# Local için: redis://localhost:6379
# Production için: rediss://user:password@host:port
REDIS_URL=redis://localhost:6379

# ============================================================================
// JWT YAPILANDIRMASI
// ============================================================================

# JWT signing secret - Güçlü ve benzersiz bir değer olmalı
# Production için: openssl rand -base64 64
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Access token süresi (varsayılan: 1h)
JWT_EXPIRES_IN=1h

# Refresh token secret - Access token'dan farklı olmalı
JWT_REFRESH_SECRET=your-refresh-token-secret-change-in-production

# Refresh token süresi (varsayılan: 7d)
JWT_REFRESH_EXPIRES_IN=7d

# ============================================================================
// MINIMAX AI YAPILANDIRMASI
// ============================================================================

# Minimax API anahtarı
# API Key almak için: https://platform.minimax.io/
MINIMAX_API_KEY=your-minimax-api-key

# Minimax API URL (Türkiye sunucusu)
MINIMAX_API_URL=https://api.minimax.chat/v1

# Minimax embedding modeli
MINIMAX_EMBEDDING_MODEL=embo-01

# ============================================================================
// CLAUDE AI YAPILANDIRMASI
// ============================================================================

# Claude API anahtarı
# API Key almak için: https://console.anthropic.com/
CLAUDE_API_KEY=your-claude-api-key

# Claude API URL
CLAUDE_API_URL=https://api.anthropic.com/v1/messages

# ============================================================================
// CLOUDFLARE R2 (Dosya Depolama)
// ============================================================================

# CloudFlare R2 hesap ID
R2_ACCOUNT_ID=your-cloudflare-account-id

# R2 erişim anahtarı
R2_ACCESS_KEY=your-r2-access-key

# R2 gizli anahtarı
R2_SECRET_KEY=your-r2-secret-key

# R2 bucket adı
R2_BUCKET=avukatpro-documents

# R2 public URL (CDN üzerinden erişim)
# Format: https://pub-xxx.r2.dev/bucket-name
R2_PUBLIC_URL=https://pub-xxx.r2.dev/avukatpro-documents

# ============================================================================
// PINECONE (Vektör Veritabanı - RAG)
// ============================================================================

# Pinecone API anahtarı
# API Key almak için: https://www.pinecone.io/
PINECONE_API_KEY=your-pinecone-api-key

# Pinecone index adı
PINECONE_INDEX_NAME=avukatpro-documents

# Pinecone environment (örn: us-west1-gcp, europe-west4-gcp)
PINECONE_ENVIRONMENT=us-west1-gcp

# ============================================================================
// NETGSM (SMS Bildirimleri)
// ============================================================================

# NetGSM kullanıcı adı
NETGSM_USER=your-netgsm-username

# NetGSM şifresi
NETGSM_PASS=your-netgsm-password

# NetGSM gönderen başlık (approve edilmiş olmalı)
NETGSM_ORGINATOR=AVUKATPRO

# ============================================================================
// SENDGRID (E-posta Bildirimleri)
// ============================================================================

# SendGrid API Key
SENDGRID_API_KEY=SG.your-sendgrid-api-key

# Gönderen e-posta adresi
SENDGRID_FROM_EMAIL=noreply@avukatpro.com

# Gönderen adı
SENDGRID_FROM_NAME=AvukatPro

# ============================================================================
// WHATSAPP BUSINESS API
// ============================================================================

# WhatsApp Business Account ID
WHATSAPP_WABA_ID=your-whatsapp-waba-id

# WhatsApp Phone Number ID
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id

# WhatsApp Access Token
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token

# ============================================================================
// FIREBASE (Push Bildirimleri)
// ============================================================================

# Firebase service account JSON
# Firebase Console > Project Settings > Service Accounts > Generate new private key
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"avukatpro","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}

# ============================================================================
// RATE LIMITING
// ============================================================================

# Rate limit penceresi (milisaniye, varsayılan: 60000 = 60 saniye)
THROTTLE_TTL=60000

# Rate limit istek sayısı (varsayılan: 100)
THROTTLE_LIMIT=100

# ============================================================================
// LOGGING
// ============================================================================

# Log seviyesi: error, warn, info, debug, verbose
LOG_LEVEL=debug

# ============================================================================
// GÜVENLİK
// ============================================================================

# CORS origin'leri (virgülle ayrılmış)
# Production'da sadece frontend domain'lerinizi girin
CORS_ORIGINS=http://localhost:3000,http://localhost:8100

# API prefix (varsayılan: api)
API_PREFIX=api

# ========================================================================
// NOTLAR
// ========================================================================
//
// 1. Bu dosyayı .env olarak kopyalayın
// 2. Tüm değerleri gerçek değerlerle doldurun
// 3. .env dosyasını .gitignore'a ekleyin (zaten backend/.gitignore'ta var)
// 4. Production'da secure bir secret yönetim sistemi kullanın
//    (AWS Secrets Manager, HashiCorp Vault, vb.)
//
// Önemli:
// - JWT_SECRET ve JWT_REFRESH_SECRET asla paylaşmayın veya commit etmeyin
// - API key'leri production'da düzenli olarak rotate edin
// - R2 ve Pinecone credential'larını güvenli tutun
//
// ========================================================================
# ============================================================================
# ÖDEME SAĞLAYICILARI (iyzico, PayTR, Stripe)
# Admin panelden seçilen sağlayıcı kullanılır
# ============================================================================

# iyzico
IYZICO_API_KEY=your_iyzico_api_key
IYZICO_SECRET_KEY=your_iyzico_secret_key
IYZICO_BASE_URL=https://api.iyzipay.com
IYZICO_TEST_MODE=true

# PayTR
PAYTR_MERCHANT_ID=your_paytr_merchant_id
PAYTR_MERCHANT_KEY=your_paytr_merchant_key
PAYTR_MERCHANT_SALT=your_paytr_merchant_salt
PAYTR_TEST_MODE=true

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Ortak
APP_URL=http://localhost:3000
